{
  "about": "Sound packs (docs/agents/sound.md): node tools/sounds.mjs <sources folder> builds assets/audio/<pack>.mp3 and assets/audio/packs.json from this. A pack loads for any of its `for` tags: 'unlock' (once sound is on), 'act N', 'jelly <type>'. A role's `cue` is the sfx call that plays it, recorded or synthesized; `vol` is its loudness; `mode` replace plays it instead of the synthesized sound, layer on top of it; `cap` cuts each take to that many seconds.",
  "packs": {
    "elite-controller": {
      "for": ["act 1"],
      "roles": {
        "controller-charge": { "cue": ["controllerCharge", false, 1.0], "vol": 0.12, "mode": "layer", "cap": 1.0, "takes": ["elite-controller/low-pitch-synth-sweep.wav"] },
        "controller-click": { "cue": ["controllerFire"], "vol": 0.25, "mode": "layer", "cap": 0.3, "takes": ["elite-controller/plastic-button-off.wav"] },
        "controller-hit": { "cue": ["controllerHit"], "vol": 0.3, "mode": "layer", "cap": 0.6, "takes": ["elite-controller/trash-lid-thud.wav"] },
        "controller-slam": { "cue": ["controllerRumble"], "vol": 0.3, "mode": "layer", "cap": 0.76, "takes": ["elite-controller/hard-door-slam.wav"] },
        "controller-down": { "cue": ["controllerDown"], "vol": 0.2, "mode": "layer", "cap": 1.6, "takes": ["elite-controller/electric-power-down.wav"] }
      }
    },
    "elite-mug": {
      "for": ["act 1"],
      "roles": {
        "mug-lob": { "cue": ["mugLob"], "vol": 0.25, "mode": "layer", "cap": 0.9, "takes": ["elite-mug/deep-bottle-slosh.wav"] },
        "mug-splash": { "cue": ["mugSplash", true], "vol": 0.25, "mode": "layer", "cap": 0.4, "takes": ["elite-mug/slime-7.wav"] },
        "mug-pour": { "cue": ["mugPour"], "vol": 0.2, "mode": "layer", "cap": 1.0, "takes": ["elite-mug/water-pour.wav"] },
        "mug-down": { "cue": ["mugDown"], "vol": 0.3, "mode": "layer", "cap": 0.7, "takes": ["elite-mug/plate-smash-24.wav"] }
      }
    },
    "elite-kettle": {
      "for": ["act 1"],
      "roles": {
        "kettle-charge": { "cue": ["kettleCharge"], "vol": 0.12, "mode": "layer", "cap": 0.9, "takes": ["elite-kettle/tiny-rocket-whistle.wav"] },
        "kettle-blast": { "cue": ["kettleBlast"], "vol": 0.2, "mode": "layer", "cap": 0.9, "takes": ["elite-kettle/pneumatic-air-release.wav"] },
        "kettle-pop": { "cue": ["kettlePop"], "vol": 0.3, "mode": "layer", "cap": 0.3, "takes": ["elite-kettle/metal-falling-3.wav"] },
        "kettle-drop": { "cue": ["kettleDrop", true], "vol": 0.25, "mode": "layer", "cap": 0.7, "takes": ["elite-kettle/sizzling-metallic-impact.wav"] },
        "kettle-down": { "cue": ["kettleDown"], "vol": 0.3, "mode": "layer", "cap": 0.8, "takes": ["elite-kettle/metal-pot-3.wav"] }
      }
    },
    "elite-soap": {
      "for": ["act 2"],
      "roles": {
        "soap-pump": { "cue": ["soapPump"], "vol": 0.2, "mode": "layer", "cap": 0.5, "takes": ["elite-soap/spray-bottle-gore-hit.wav"] },
        "soap-bubbles": { "cue": ["soapBubbles"], "vol": 0.2, "mode": "layer", "cap": 0.45, "takes": ["elite-soap/single-bubble-cluster.wav"] },
        "soap-bubble-pop": { "cue": ["bubblePop"], "vol": 0.18, "mode": "layer", "takes": ["elite-soap/mouth-bubble-pop-2.wav"] },
        "soap-down": { "cue": ["soapDown"], "vol": 0.3, "mode": "layer", "cap": 0.4, "takes": ["elite-soap/bottle.wav"] }
      }
    },
    "elite-clock": {
      "for": ["act 2"],
      "roles": {
        "clock-sweep": { "cue": ["clockSweep"], "vol": 0.18, "mode": "layer", "cap": 0.5, "takes": ["elite-clock/fast-cable-whoosh.wav"] },
        "clock-strike": { "cue": ["clockStrike", true], "vol": 0.25, "mode": "layer", "cap": 0.45, "takes": ["elite-clock/ringing-metal.wav"] },
        "clock-chime": { "cue": ["clockChime", 0], "vol": 0.2, "mode": "layer", "cap": 0.78, "takes": ["elite-clock/glassy-church-bell-hit.wav"] },
        "wreath-whirr": { "cue": ["wreathWhirr"], "vol": 0.15, "mode": "layer", "cap": 0.43, "takes": ["elite-clock/bamboo-swing-transition-effect.wav"] },
        "clock-down": { "cue": ["clockDown"], "vol": 0.3, "mode": "layer", "cap": 1.0, "takes": ["elite-clock/trap-springing-shut.wav"] }
      }
    },
    "elite-whipper": {
      "for": ["act 2"],
      "roles": {
        "balloon-fill": { "cue": ["balloonFill", 1.0], "vol": 0.1, "mode": "layer", "cap": 1.0, "takes": ["elite-whipper/balloon-inflation.wav"] },
        "balloon-loose": { "cue": ["balloonLoose"], "vol": 0.2, "mode": "layer", "cap": 0.6, "takes": ["elite-whipper/balloon-rub-squeak.wav"] },
        "balloon-pop": { "cue": ["balloonPop"], "vol": 0.3, "mode": "layer", "cap": 0.32, "takes": ["elite-whipper/balloon-popping.wav"] },
        "cream-spray": { "cue": ["creamSpray"], "vol": 0.2, "mode": "layer", "cap": 0.5, "takes": ["elite-whipper/aerosol-can-14.wav"] },
        "cream-splat": { "cue": ["creamSplat"], "vol": 0.25, "mode": "layer", "cap": 0.36, "takes": ["elite-whipper/mud-splat.wav"] },
        "whipper-down": { "cue": ["whipperDown"], "vol": 0.2, "mode": "layer", "cap": 0.8, "takes": ["elite-whipper/torch-gas-flow.wav"] }
      }
    },
    "lightning": {
      "for": ["jelly lightning", "act 4"],
      "roles": {
        "lightning-launch": { "cue": ["elementLaunch", "lightning"], "vol": 0.12, "mode": "replace", "takes": ["lightning/launch-1.mp3", "lightning/launch-2.mp3"] },
        "lightning-hit": { "cue": ["elementHit", "lightning"], "vol": 0.22, "mode": "replace", "takes": ["lightning/hit-1.mp3", "lightning/hit-2.mp3", "lightning/hit-3.mp3"] },
        "lightning-big": { "cue": ["lightningBig"], "vol": 0.2, "mode": "replace", "takes": ["lightning/big-1.mp3", "lightning/big-2.mp3", "lightning/big-3.mp3"] },
        "lightning-chain": { "cue": ["chainZap", 0], "vol": 0.12, "mode": "replace", "takes": ["lightning/chain-1.mp3", "lightning/chain-2.mp3", "lightning/chain-3.mp3"] }
      }
    },
    "core": {
      "for": ["unlock"],
      "roles": {
        "bubble-blow": { "cue": ["blow"], "vol": 0.1, "mode": "replace", "cap": 0.45, "takes": ["core/puff-of-smoke.wav"]},
        "bubble-hit": { "cue": ["hit"], "vol": 0.2, "mode": "replace", "cap": 0.22, "takes": ["core/crisp-splat-hit.wav", "core/crisp-splat-hit-var-01.wav"]},
        "bubble-pop": { "cue": ["pop", false], "vol": 0.16, "mode": "replace", "cap": 0.28, "takes": ["core/bubble-bursting.wav", "core/bubble-bursting-var-01.wav"]},
        "bubble-pop-big": { "cue": ["pop", true], "vol": 0.2, "mode": "replace", "cap": 0.32, "takes": ["core/bubble-2.wav"]},
        "crit": { "cue": ["crit"], "vol": 0.2, "mode": "replace", "cap": 0.3, "takes": ["core/sparkle-shimmer-hit.wav"]},
        "kill": { "cue": ["kill", 1], "vol": 0.22, "mode": "replace", "cap": 0.35, "takes": ["core/step-on-slug-splat-short.wav", "core/step-on-slug-splat-short-var-01.wav"]},
        "kill-big": { "cue": ["kill", 1.6], "vol": 0.26, "mode": "replace", "cap": 0.45, "takes": ["core/step-on-slug-splat-long.wav"]},
        "jump": { "cue": ["jump"], "vol": 0.07, "mode": "replace", "cap": 0.3, "takes": ["core/game-jump-boing.wav"]},
        "land": { "cue": ["land", 0.5], "vol": 0.18, "mode": "replace", "cap": 0.4, "takes": ["core/water-splash-close-up.wav"]},
        "hurt": { "cue": ["hurt"], "vol": 0.28, "mode": "replace", "cap": 0.4, "takes": ["core/slime-8.wav"]},
        "shield-up": { "cue": ["shieldReady"], "vol": 0.14, "mode": "replace", "cap": 0.6, "takes": ["core/force-field-3.wav"]},
        "shield-hit": { "cue": ["shieldHit", true], "vol": 0.16, "mode": "replace", "cap": 0.4, "takes": ["core/short-ceramic-bell-hit-30.wav"]},
        "shield-break": { "cue": ["shieldBreak", true], "vol": 0.24, "mode": "replace", "cap": 0.4, "takes": ["core/glass-3.wav"]}
      }
    },
    "rewards": {
      "for": ["unlock"],
      "roles": {
        "xp-pickup": {"cue": ["xp", 0], "vol": 0.2, "mode": "replace", "takes": ["rewards/bright-coin-pickup.wav"]},
        "treasure-pickup": {"cue": ["treasure"], "vol": 0.2, "mode": "replace", "cap": 1.2, "takes": ["rewards/coin-pickup-short.wav"]},
        "level-up": {"cue": ["levelUp"], "vol": 0.22, "mode": "replace", "takes": ["rewards/level-up-chime.wav"]},
        "chest-creak": {"cue": ["chestCreak", 0], "vol": 0.2, "mode": "replace", "takes": ["rewards/wooden-chest-open.wav"]},
        "chest-pop": {"cue": ["chestPop", 0], "vol": 0.2, "mode": "replace", "cap": 1.0, "takes": ["rewards/treasure.wav"]},
        "reveal-0": {"cue": ["reveal", 0], "vol": 0.14, "mode": "replace", "cap": 0.45, "takes": ["rewards/shimmer-peak.wav"]},
        "reveal-1": {"cue": ["reveal", 1], "vol": 0.16, "mode": "replace", "cap": 0.8, "takes": ["rewards/shimmer-peak.wav"]},
        "reveal-2": {"cue": ["reveal", 2], "vol": 0.18, "mode": "replace", "cap": 1.3, "takes": ["rewards/shimmer-peak.wav"]},
        "reveal-3": {"cue": ["reveal", 3], "vol": 0.2, "mode": "replace", "cap": 2.2, "takes": ["rewards/shimmer-peak.wav"]},
        "award": {"cue": ["award"], "vol": 0.22, "mode": "replace", "cap": 2.6, "takes": ["rewards/shimmer-peak.wav"]},
        "buy": {"cue": ["buy"], "vol": 0.2, "mode": "replace", "cap": 1.4, "takes": ["rewards/cash-register-purchase.wav"]},
        "menu-tap": {"cue": ["tap"], "vol": 0.16, "mode": "replace", "takes": ["rewards/soft-ui-tap.wav"]},
        "menu-pick": {"cue": ["pick"], "vol": 0.16, "mode": "replace", "takes": ["rewards/confirmation-4.wav"]}
      }
