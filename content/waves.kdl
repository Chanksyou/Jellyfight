// How the night fills with bugs (run.js spawnWaves). Times are seconds into the act; `act` is
// which act a bug comes out in (1 if left out). Which bugs exist and how they behave:
// content/enemies.kdl. An act's own toughness (src/stage*.js) multiplies its bugs' health.

spawning {
    rate 0.22 grow=0.0022       // bugs per second at midnight, and how much faster each second after
    cap 6 every=15 max=20       // most alive at once: 6, one more every 15 s, never more than 20
    toughen 0.18                // each minute into the night, new bugs have 18% more health
}

bug "roach" weight=1                // cockroaches from the start
bug "ants" weight=0.5 from=30       // ant squads from 0:30
bug "mosquito" weight=0.45 from=90  // mosquitoes from 1:30
bug "lanternfly" weight=0.3 from=120 // spotted lanternflies from 2:00

// act 2: the hallway and the bathroom
bug "roach" weight=0.8 act=2                // cockroaches from the start
bug "hair" weight=0.6 act=2                 // hair tangles from the drain, from the start
bug "ants" weight=0.45 from=20 act=2        // ant squads from 0:20
bug "housefly" weight=0.4 from=30 act=2     // house flies from 0:30
bug "spider" weight=0.35 from=45 act=2      // house spiders from 0:45
bug "millipede" weight=0.3 from=60 act=2    // giant millipedes from 1:00
bug "mosquito" weight=0.35 from=75 act=2    // mosquitoes from 1:15
bug "ladybug" weight=0.25 from=90 act=2     // ladybugs from 1:30
bug "stapler" weight=0.3 from=105 act=2     // standing staplers from 1:45
bug "lanternfly" weight=0.25 from=150 act=2 // spotted lanternflies from 2:30
