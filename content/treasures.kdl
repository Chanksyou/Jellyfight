    level 3 text="When hit: shoves bugs within 30 cm and Stuns them for 0.9 s. 3 s cooldown. Not Elites or the Boss." {
        squeak-when-hit radius=0.3 push=0.22 dmg=0 stun=0.9 cooldown=3
    }
}
treasure "whale" heals=#true name="Whale Bath Toy" icon="🐳" rarity="rare" text="On landing: +1.5 Health. 4 s cooldown." {
    land-heal 1.5 every=4
    level 2 text="On landing: +2 Health. 3.5 s cooldown." {
