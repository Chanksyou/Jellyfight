treasure "coffeeBean" name="Coffee Bean" icon="🫘" attack=#true text="Bubbles blow 25% faster." {
    stat blow-rate 25 percent=#true
}
treasure "straw" name="Drinking Straw" icon="🥤" text="Blow through a straw: bubbles reach 40% farther." {
    stat range 40 percent=#true
}
treasure "lemon" name="Lemon Slice" icon="🍋" attack=#true text="Sour bubbles: +2 pop damage." {
    stat pop 2
}
treasure "bubbleWand" name="Bubble Wand" icon="🪄" attack=#true text="One more bubble in the stream." {
    stat bubbles 1
}
treasure "thumbtack" name="Thumbtack" icon="📌" attack=#true text="Sharp bubbles: they pierce 2 enemies and slow what they hit." {
    pierce 2
    slow-on-hit 1 by="bubbles"
