// Treasures: lost things you keep for the rest of the run, picked from gift boxes
// and beaten elites. Each is a name, an icon, the line the pick screen shows, and effect words;
// every word is defined once in src/words.js (TREASURE_WORDS) with what its numbers mean.
// Damage numbers are multiples of your power (pop damage x 1.8) unless a word says otherwise.
// Tentacles aren't improved by treasures (the Stinging Frills evolution is the way).
//
//   attack=#true   it changes how you attack: the starting pick always offers one of these
//   rarity="…"     common, rare, epic or legendary: how often it's offered (stats.js
//                  TREASURE_RARITY; Luck shifts the odds up). Rate damage treasures with
//                  tests/clear.mjs (x faster at clearing 10 clumped cockroaches: legendary 3.5x+,
//                  epic 2x+, rare 1.4x+); rate the rest by how unique the effect is.
//   stack=N        you can own up to N copies and their effects add up (default 1: unique).
//                  Keep stacking for plain number boosts; anything with its own trick stays unique.
//
// A new treasure that combines existing words needs no code: add it here and a story.

// --- your bubbles (bubbles.js)
treasure "bobbyPin" name="Bobby Pin" icon="🧷" rarity="rare" attack=#true text="Bubbles pierce, popping on up to 3 enemies in a line." {
    pierce 3
}
treasure "hairTie" name="Hair Tie" icon="➰" rarity="rare" attack=#true text="Each bubble that pops blows a smaller one at another enemy nearby." {
    split-bubble
}
treasure "goldRing" name="Gold Ring" icon="💍" rarity="common" text="Every 10th bubble is golden and does 5x damage." {
    golden-bubble every=10 mult=5
}
treasure "reedStick" name="Reed Stick" icon="🎋" rarity="epic" attack=#true text="Every 6th bubble brings a giant, slow one that pops for a big splash." {
    giant-bubble every=6 size=2.5 dmg=4 speed=0.6
}

// --- elements for your bubbles (bubbles.js); they stack
treasure "candle" name="Birthday Candle" icon="🕯️" rarity="legendary" attack=#true text="Fire bubbles: enemies burn for 3 s. Fire on a frozen enemy shatters it for triple damage." {
    element "fire"
}
treasure "battery" name="AA Battery" icon="🔋" rarity="legendary" attack=#true text="Lightning bubbles: every pop arcs to 3 more enemies nearby, stunning each." {
    element "lightning"
}
treasure "freezerPack" name="Freezer Pack" icon="❄️" rarity="rare" attack=#true text="Ice bubbles: hits chill and slow; the 2nd chilled hit freezes the enemy solid." {
    element "ice"
}
treasure "nailPolish" name="Nail Polish" icon="💅" rarity="legendary" attack=#true text="Acid bubbles: pops leave a puddle that eats at anything standing in it." {
    element "acid"
}
treasure "paperFan" name="Paper Fan" icon="🌬️" rarity="common" attack=#true text="Wind bubbles: whatever they hit gets blown backward." {
    element "wind"
}
treasure "glitter" name="Glitter" icon="✨" rarity="legendary" attack=#true text="Glitter bubbles: the splash is twice as wide and hits harder." {
    element "glitter"
}

// --- hits, jumps and your body
treasure "nailClipper" name="Nail Clipper" icon="✂️" rarity="common" text="1 in 5 hits (bubbles and tentacles) does triple damage." {
    crit chance=0.2 mult=3 by="all"
}
treasure "stickyNote" name="Sticky Note" icon="🗒️" rarity="common" text="Enemies you hit are marked for 3 s and take 50% more damage from everything." {
    mark-on-hit 3 by="all"
}
treasure "penSpring" name="Pen Spring" icon="🌀" rarity="rare" text="Get an additional jump in mid-air (take up to 3 for a quadruple jump)." stack=3 {
    extra-jumps 1
}
treasure "cottonBall" name="Cotton Ball" icon="☁️" rarity="rare" attack=#true text="Land from a jump to send out a soft shockwave that stings." {
    landing-shockwave 0.08 dmg=2 drop=0.04
}
treasure "rubberDuck" name="Rubber Duck" icon="🦆" rarity="common" text="When you get hit, a squeak knocks nearby enemies back. (5 s)" {
    squeak-when-hit radius=0.09 push=0.06 dmg=3 cooldown=5
}
treasure "whale" name="Whale Bath Toy" icon="🐳" rarity="rare" text="Stand still for a second and you start spouting, refilling moisture." {
    spout after=1 heal=0.5
}
treasure "babyBottle" name="Baby Bottle" icon="🍼" rarity="common" text="Every enemy you clear gives back a sip of moisture." {
    heal-on-kill 0.5
}
treasure "bathSalt" name="Bath Salt" icon="🧂" rarity="epic" text="Enemies you finish off burst and hurt their neighbors." {
    burst-on-kill 0.045 dmg=0.5
}

// --- things that attack on their own (gadgets.js)
treasure "guitarPick" name="Guitar Pick" icon="🎸" rarity="rare" attack=#true text="Every 5 s a chord rings out, stinging and pushing back everything close." {
    every 5 {
        ring 0.13 dmg=1.2 push=0.035 color="#c08aff" show=0.45
    }
}
treasure "bathBomb" name="Bath Bomb" icon="💥" rarity="rare" attack=#true text="Every 6 s you fizz, stinging everything close around you." {
    every 6 first=6 {
        ring 0.09 dmg=1.5 color="#ff9ad8" look="puff" elites=#false
    }
}
treasure "iceCube" name="Ice Cube" icon="🧊" rarity="rare" attack=#true text="Every 8 s a cold snap freezes everything close for 2 s. Frozen things can't hurt you." {
    every 8 {
        ring 0.16 dmg=0.5 freeze=2 color="#bff4ff" show=0.6
    }
}
treasure "remote" name="TV Remote" icon="📺" rarity="rare" attack=#true text="Every 7 s, zap the 3 nearest enemies for double damage." {
    every 7 {
        zap 3 range=0.45 dmg=2
    }
}
treasure "legoBrick" name="Lego Brick" icon="🧱" rarity="common" attack=#true text="Drop a brick every 4 s. Anything that steps on it takes a huge hit." {
    every 4 {
        brick dmg=4 last=14 most=5
    }
}
treasure "marble" name="Marble" icon="🔮" rarity="common" attack=#true text="Every 5 s a marble rolls out ahead of you, bouncing off walls and bowling through enemies." {
    every 5 {
        marble dmg=2 speed=0.825 life=1.47
    }
}
treasure "fairyLights" name="Fairy Lights" icon="💡" rarity="epic" attack=#true text="Three little bulbs circle you and sting whatever they touch." {
    orbit-lights 3 radius=0.07 dmg=0.6
}
treasure "magnifier" name="Magnifying Glass" icon="🔍" rarity="epic" attack=#true text="Focused moonlight burns the nearest enemy, nonstop." {
    beam range=0.35 dmg=0.3 tick=0.25
}
treasure "glowStick" name="Glow Stick" icon="🟢" rarity="legendary" attack=#true text="A soft glow around you stings anything inside it." {
    aura 0.08 dmg=0.4 tick=0.5
}

// --- things that bend the rules
treasure "coin" name="Lucky Penny" icon="🪙" rarity="common" text="Enemies drop 25% more dew." stack=3 {
    dew-mult 1.25
}
treasure "dice" name="Game Die" icon="🎲" rarity="epic" text="Level-up cards roll one rarity higher." {
    card-rarity 1
}

// --- found later: more lost things
treasure "handCream" name="Hand Cream" icon="🧴" rarity="common" text="Your moisture slowly refills: +0.3 a second." stack=3 {
    stat regen 0.3
}
treasure "sock" name="Odd Sock" icon="🧦" rarity="common" text="Slippery: 15% of hits miss you entirely." stack=3 {
    stat dodge 15
}
treasure "bandage" name="Bandage" icon="🩹" rarity="rare" text="Every 5 enemies you clear, +1 max moisture for good." stack=2 {
    grow-on-kills moisture 1 kills=5
}
