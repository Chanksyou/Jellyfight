// Treasures: things you keep for the rest of the run, picked when you open a treasure (a golden
// chest that turns up in the room, or one an elite leaves)
// and beaten elites. Each is a name, an icon, the line the pick screen shows, and effect words;
// every word is defined once in src/words.js (TREASURE_WORDS) with what its numbers mean.
// Damage numbers are multiples of your power (attack damage x 1.8) unless a word says otherwise.
// Tentacles grow with the Stinging Frills evolution and their own treasures (Spaghetti Strand, Tape Measure, Chopsticks, Stinging Nettle, Paperclip Chain).
//
//   attack=#true   it changes how you attack
//   rarity="…"     common, rare, epic or legendary: how often it's offered (stats.js
//                  TREASURE_RARITY; Luck shifts the odds up). Rate damage treasures with
//                  tests/clear.mjs (x faster at clearing 10 clumped cockroaches: legendary 3.5x+,
//                  epic 2x+, rare 1.4x+); rate the rest by how unique the effect is. Legendary is
//                  for unique rule-changers: the Boss reward offers only these.
//   needs="id"     offered only once you own that treasure
//   needs-stat="…" offered only once that stat (names as in the `stat` word) is above 0
//   needs-chance=#true  offered only once you own an effect that rolls a chance (crit, trap, ghosts, life steal...)
//   heals=#true    all it does is give back Health (or it trades for that): not offered once Pot Lid
//                  (health-to-shield) holds your max Health at 1
//   not-for="…"    never offered to a jelly type with one of these attacks (attack= in
//                  content/jellies.kdl), because it does nothing for them (Range for tentacles)
//   stack=N        you can own up to N copies and their effects add up. A treasure without levels
//                  stacks by default (3 copies; at most 5); stack=1 makes a rule-changer one of a
//                  kind. Legendary treasures are always unique.
//   level 2 text="…" { words }, level 3 …   a treasure with its own trick can level up instead:
//                  take it again for its next level (only ever the one after the level you have),
//                  each level being its whole word list. The pick card shows its text.
//
// A new treasure that combines existing words needs no code: add it here and a story.

// --- your bubbles (bubbles.js)
treasure "bobbyPin" name="Bobby Pin" icon="🧷" rarity="rare" attack=#true not-for="poison glitter tentacle" text="Attacks pierce up to 4 bugs." {
    pierce 4
    level 2 text="Attacks pierce up to 8 bugs." {
        pierce 8
    }
    level 3 text="Attacks pierce up to 12 bugs." {
        pierce 12
    }
}
// a payout, not a crit (Nail Clipper is the extra damage): works for every jelly type's attack
treasure "goldRing" name="Gold Ring" icon="💍" rarity="common" text="Every 10th attack: golden. Its kills drop an XP gem worth 4x." {
    golden-bubble every=10 mult=1 coin=4
    level 2 text="Every 8th attack: golden. Its kills drop an XP gem worth 5x." {
        golden-bubble every=8 mult=1 coin=5
    }
    level 3 text="Every 6th attack: golden. Its kills drop an XP gem worth 6x." {
        golden-bubble every=6 mult=1 coin=6
    }
}
treasure "reedStick" name="Reed Stick" icon="🎋" rarity="epic" attack=#true not-for="fire lightning ice poison wind glitter tentacle" text="Every 6th bubble: a giant, slow one that bursts in a big splash." {
    giant-bubble every=6 size=2.5 dmg=5 speed=0.6
    level 2 text="Every 5th bubble: a giant, slow one that bursts in a big splash." {
        giant-bubble every=5 size=2.5 dmg=4 speed=0.6
    }
    level 3 text="Every 3rd bubble: a bigger, slow one that bursts in a big splash." {
        giant-bubble every=3 size=2.8 dmg=4.5 speed=0.6
    }
}

// --- element attacks (bubbles.js): each fires its own projectile on its own timer, separate from
// your bubbles. They're Legendary: you pick one at the start of a run, and the Boss reward (a
// Legendary pick) always offers at least one you don't have; never from treasures in the room. Attack damage, Fire rate, Range, Attack size and extra Attacks all
// apply to them. Their numbers: ELEMENT_BASE in src/words.js.
treasure "nailClipper" name="Nail Clipper" icon="✂️" rarity="rare" text="10% of hits: Crit for 3x damage." stack=3 {
    crit chance=0.1 mult=3 by="all"
}
treasure "stickyNote" name="Sticky Note" icon="🗒️" rarity="common" text="Hits mark bugs for 3 s: they take 30% more damage." {
    mark-on-hit 3 by="all" more=0.3
    level 2 text="Hits mark bugs for 4 s: they take 35% more damage." {
        mark-on-hit 4 by="all" more=0.35
    }
    level 3 text="Hits mark bugs for 5 s: they take 40% more damage." {
        mark-on-hit 5 by="all" more=0.4
    }
}
treasure "penSpring" name="Pen Spring" icon="🌀" rarity="rare" text="+1 mid-air jump." stack=3 {
    extra-jumps 1
}
treasure "cottonBall" name="Cotton Ball" icon="☁️" rarity="rare" attack=#true text="On landing: a shockwave stings nearby bugs." {
    landing-shockwave 0.2 dmg=1.2 drop=0.04
    level 2 text="On landing: a wider, stronger shockwave stings nearby bugs." {
        landing-shockwave 0.4 dmg=5 drop=0.04
    }
    level 3 text="On landing: a big, strong shockwave stings nearby bugs." {
        landing-shockwave 0.6 dmg=7 drop=0.04
    }
}
// pure control (no damage): Windowsill Cactus is the one that hurts back
treasure "rubberDuck" name="Rubber Duck" icon="🦆" rarity="common" text="When hit: shove nearby bugs back and Stun them for 0.5 s. 4 s cooldown." {
    squeak-when-hit radius=0.25 push=0.15 dmg=0 stun=0.5 cooldown=4
    level 2 text="When hit: shove nearby bugs farther back and Stun them for 0.7 s. 4 s cooldown." {
        squeak-when-hit radius=0.28 push=0.18 dmg=0 stun=0.7 cooldown=4
    }
    level 3 text="When hit: shove nearby bugs far back and Stun them for 0.9 s. 3 s cooldown." {
        squeak-when-hit radius=0.3 push=0.22 dmg=0 stun=0.9 cooldown=3
    }
}
treasure "whale" heals=#true name="Whale Bath Toy" icon="🐳" rarity="rare" text="On landing: +1.5 Health. 4 s cooldown." {
    land-heal 1.5 every=4
    level 2 text="On landing: +2 Health. 3.5 s cooldown." {
        land-heal 2 every=3.5
    }
    level 3 text="On landing: +2.5 Health. 3 s cooldown." {
        land-heal 2.5 every=3
    }
}
treasure "babyBottle" heals=#true name="Baby Bottle" icon="🍼" rarity="common" text="On a kill: +0.2 Health." {
    heal-on-kill 0.2
    level 2 text="On a kill: +0.3 Health." {
        heal-on-kill 0.3
    }
    level 3 text="On a kill: +0.4 Health." {
        heal-on-kill 0.4
    }
}
treasure "bathSalt" name="Bath Salt" icon="🧂" rarity="epic" text="Kills burst, hurting nearby bugs." {
    burst-on-kill 0.035 dmg=1
    level 2 text="Kills burst wider and harder, hurting nearby bugs." {
        burst-on-kill 0.04 dmg=1.5
    }
    level 3 text="Kills burst much wider and harder, hurting nearby bugs." {
        burst-on-kill 0.045 dmg=2
    }
}

// --- things that attack on their own (gadgets.js)
treasure "guitarPick" name="Guitar Pick" icon="🎸" rarity="rare" attack=#true text="Every 5 s: a chord stings and pushes back nearby bugs." {
    every 5 {
        ring 0.18 dmg=2 push=0.05 color="#c08aff" look="chord" show=0.45
    }
    level 2 text="Every 4 s: a wider chord stings and pushes back nearby bugs." {
        every 4 {
            ring 0.22 dmg=3 push=0.07 color="#c08aff" look="chord" show=0.45
        }
    }
    level 3 text="Every 3 s: a wide, strong chord stings and pushes back nearby bugs." {
        every 3 {
            ring 0.26 dmg=4 push=0.09 color="#c08aff" look="chord" show=0.45
        }
    }
}
treasure "bathBomb" name="Bath Bomb" icon="💥" rarity="rare" attack=#true text="Every 6 s: a bath bomb hits the biggest crowd for 2x Attack damage and throws bugs up, Stunned until they land." {
    every 6 first=6 {
        geyser dmg=2 radius=0.1 lift=0.4
    }
    level 2 text="Every 5 s: a bath bomb hits the biggest crowd for 3x Attack damage and throws bugs up, Stunned until they land." {
        every 5 first=5 {
            geyser dmg=3 radius=0.12 lift=0.45
        }
    }
    level 3 text="Every 4 s: a wider bath bomb hits the biggest crowd for 4x Attack damage and throws bugs higher, Stunned until they land." {
        every 4 first=4 {
            geyser dmg=4 radius=0.14 lift=0.5
        }
    }
}
treasure "iceCube" name="Ice Cube" icon="🧊" rarity="rare" attack=#true text="Every 6 s: an ice puddle for 5 s. Bugs on it are Stunned for 0.5 s; you get +25% Move speed on it." {
