}
treasure "flashlight" name="Flashlight" icon="🔦" attack=#true text="Every 3 s, a flash of light stings everything near you." {
    every 3 {
        ring 0.11 dmg=0.8 color="#fff6b0" show=0.3
    }
}
treasure "dart" name="Dart" icon="🎯" attack=#true text="Every 3 s, the nearest enemy takes a huge hit." {
    every 3 {
        zap 1 range=0.4 dmg=4
    }
}
treasure "alarmClock" name="Alarm Clock" icon="⏰" attack=#true text="Every 12 s it rings: everything close is knocked far back." {
    every 12 {
        ring 0.18 dmg=0.5 push=0.08 color="#ffd23a" show=0.5
    }
}
treasure "snowGlobe" name="Snow Globe" icon="🌨️" attack=#true text="Every 6 s a flurry freezes everything close for 1 s, and you refill 1 moisture." {
