// Treasures: things you keep for the rest of the run, picked when you open a treasure (a golden
// chest that turns up in the room, or one an elite leaves)
// and beaten elites. Each is a name, an icon, the line the pick screen shows, and effect words;
// every word is defined once in src/words.js (TREASURE_WORDS) with what its numbers mean.
// Damage numbers are multiples of your power (bubble damage x 1.8) unless a word says otherwise.
// Tentacles grow with the Stinging Frills evolution and their own treasures (Spaghetti Strand, Tape Measure, Chopsticks, Stinging Nettle, Paperclip Chain).
//
//   attack=#true   it changes how you attack
//   rarity="…"     common, rare, epic or legendary: how often it's offered (stats.js
//                  TREASURE_RARITY; Luck shifts the odds up). Rate damage treasures with
//                  tests/clear.mjs (x faster at clearing 10 clumped cockroaches: legendary 3.5x+,
//                  epic 2x+, rare 1.4x+); rate the rest by how unique the effect is. Legendary is
//                  for unique rule-changers and the Elements: the Boss reward offers only these.
//   needs="id"     offered only once you own that treasure (an element's upgrades need its base)
//   stack=N        you can own up to N copies and their effects add up. A treasure without levels
//                  stacks by default (3 copies; at most 5); stack=1 makes a rule-changer one of a
//                  kind. Legendary treasures, the elements and their upgrades are always unique.
//   level 2 text="…" { words }, level 3 …   a treasure with its own trick can level up instead:
//                  take it again for its next level (only ever the one after the level you have),
//                  each level being its whole word list. The pick card shows its text.
//
// A new treasure that combines existing words needs no code: add it here and a story.

// --- your bubbles (bubbles.js)
treasure "bobbyPin" name="Bobby Pin" icon="🧷" rarity="rare" attack=#true text="Bubbles pierce, popping on up to 3 enemies in a line." {
    pierce 3
    level 2 text="Level 2: pierce up to 5 enemies." {
        pierce 5
    }
    level 3 text="Level 3: pierce up to 7 enemies." {
        pierce 7
    }
}
treasure "goldRing" name="Gold Ring" icon="💍" rarity="common" text="Every 10th bubble is golden and does 5x damage." {
    golden-bubble every=10 mult=5
    level 2 text="Level 2: every 8th bubble is golden." {
        golden-bubble every=8 mult=5
    }
    level 3 text="Level 3: every 7th bubble is golden, for 6x damage." {
        golden-bubble every=7 mult=6
    }
}
treasure "reedStick" name="Reed Stick" icon="🎋" rarity="epic" attack=#true text="Every 6th bubble brings a giant, slow one that pops for a big splash." {
    giant-bubble every=6 size=2.5 dmg=8 speed=0.6
    level 2 text="Level 2: a giant one every 5th bubble." {
        giant-bubble every=5 size=2.5 dmg=10 speed=0.6
    }
    level 3 text="Level 3: a bigger giant every 4th bubble." {
        giant-bubble every=4 size=2.8 dmg=12 speed=0.6
    }
}

// --- element attacks (bubbles.js): each fires its own projectile on its own timer, separate from
// your bubbles. They're Legendary: you pick one at the start of a run, and the Boss reward (a
// Legendary pick) always offers at least one you don't have; never from treasures in the room. Bubble damage, Fire rate, Range, Bubble size and extra Bubbles all
// apply to them. Their numbers: ELEMENT_BASE in src/words.js.
treasure "candle" name="Birthday Candle" icon="🕯️" rarity="legendary" attack=#true text="Fire attack: you also shoot fireballs that set enemies burning for 3 s. Fire on a frozen enemy shatters it for triple damage." {
    element "fire"
}
treasure "battery" name="AA Battery" icon="🔋" rarity="legendary" attack=#true text="Lightning attack: you also shoot ball lightning; every pop arcs to 3 more enemies nearby, stunning each." {
    element "lightning"
}
treasure "freezerPack" name="Freezer Pack" icon="❄️" rarity="legendary" attack=#true text="Ice attack: you also shoot ice shards that chill and slow; the 2nd chilled hit freezes the enemy solid." {
    element "ice"
}
treasure "nailPolish" name="Nail Polish" icon="💅" rarity="legendary" attack=#true text="Acid attack: you also lob acid globs that leave a puddle eating at anything standing in it." {
    element "acid"
}
treasure "paperFan" name="Paper Fan" icon="🌬️" rarity="legendary" attack=#true text="Wind attack: you also throw crescent wind blades that cut across a wide arc, pierce, and blow what they hit backward." {
    element "wind"
}
treasure "glitter" name="Glitter" icon="✨" rarity="legendary" attack=#true text="Glitter attack: you also lob glitter bombs that burst in a wide, hard-hitting splash." {
    element "glitter"
}

