}

// --- the Shield (shield.js): offered only once you have a Shield bar (needs-stat)
treasure "crankFlashlight" name="Crank Flashlight" icon="🔦" rarity="common" needs-stat="shield" text="Your Shield refills 50% faster." {
    shield-recharge faster=0.5
    level 2 text="Your Shield refills twice as fast and starts refilling 1 s sooner." {
        shield-recharge faster=1 sooner=1
    }
    level 3 text="Your Shield refills 2.5x as fast and starts refilling 1.5 s sooner." {
        shield-recharge faster=1.5 sooner=1.5
    }
}
