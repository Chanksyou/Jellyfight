treasure "piggyBank" name="Piggy Bank" icon="🐷" rarity="common" text="+3% Bubble damage for every treasure found this run." stack=5 {
    per "bubble-damage" 3 every=1 of="chests" percent=#true
}

// --- conditionals (while): a bonus only while something holds
treasure "drySock" name="Dry Sock" icon="🧺" rarity="epic" text="+40% Bubble damage while you're in the air." stack=3 {
    while "airborne" "bubble-damage" 40 percent=#true
}

// --- on-kill: grows with every bug cleared, up to a cap per copy; or leaves something behind
treasure "dustpan" name="Dustpan" icon="🧹" rarity="rare" attack=#true text="Each bug cleared adds 0.2% Bubble damage this run, up to +100%." stack=3 {
    grow-on-kills "bubble-damage" 0.2 kills=1 percent=#true cap=100
}
treasure "meatball" name="Meatball, Leftover" icon="🍖" rarity="rare" text="10% of the bugs you clear leave a crumb: +1 Health." stack=5 {
    crumb-on-kill chance=0.1 health=1
}

// --- when hit (when-hit): getting hurt hits back
treasure "cactus" name="Windowsill Cactus" icon="🌵" rarity="rare" text="When you're hit, needles spray at every bug within 45 cm (up to 5 times a second)." stack=3 {
    when-hit cooldown=0.2 {
        ring 0.45 dmg=0.5 color="#8fffc8" look="needles" show=0.35
    }
}
treasure "kettleCord" name="Toaster Cord" icon="🍞" rarity="rare" attack=#true text="When a bug hits you, a tentacle lashes back at it for twice your Tentacle damage (up to 5 times a second)." stack=3 {
    when-hit cooldown=0.2 {
        lash dmg=2 range=0.4
    }
}

// --- procs: now and then a hit does something more
treasure "staticBalloon" name="Static Balloon" icon="🎈" rarity="rare" attack=#true text="20% chance per copy for bubble pops to zap a bug within 30 cm, stunning it for 0.5 s." stack=2 {
    zap-on-pop chance=0.2 count=1 range=0.3 stun=0.5
}
treasure "thumbtack" name="Thumbtack" icon="📌" rarity="rare" attack=#true text="+5% crit chance, and critical hits pin the bug in place for 0.8 s." stack=1 {
    crit chance=0.05 mult=3
    pin-on-crit 0.8
}

// --- Legendary: rule-changers, one of a kind (the Boss reward offers these)
treasure "handMirror" name="Hand Mirror" icon="🪞" rarity="legendary" text="Every 8 s, the first hit you take shatters back: whatever dealt it takes a heavy hit, a shockwave hits and throws back everything close, and you can't be hurt for 1 s." {
    reflect every=8 invuln=1 dmg=8 burst=0.15 burstDmg=3 push=0.05
}
treasure "snooze" name="Snooze Button" icon="⏰" rarity="legendary" text="Once a run, a hit that would take your last Health leaves you at half instead." {
    death-save health=0.5
}
treasure "discoBall" name="Disco Ball" icon="🪩" rarity="legendary" attack=#true text="Every bubble that pops on a bug fires again from there at the next bug, for 60% of its damage." {
    echo-bubble dmg=0.6
}
treasure "bubbleBath" name="Bubble Bath" icon="🛁" rarity="legendary" attack=#true text="Every 5 s, a ring of 8 bubbles bursts out from you in every direction." {
    every 5 {
        bubble-ring 8
    }
}
treasure "hotWaterBottle" name="Hot Water Bottle" icon="🫖" rarity="legendary" text="Below half Health you steam: +50% Fire rate, +40% Bubble damage and +20% Move speed." {
    while "low-health" "fire-rate" 50 percent=#true under=0.5
    while "low-health" "bubble-damage" 40 percent=#true under=0.5
    while "low-health" "move-speed" 20 percent=#true under=0.5
}
treasure "powerBank" name="Power Bank" icon="🔆" rarity="legendary" attack=#true text="Every element you own fires 50% faster." {
    element-up "fire" rate=1.5
    element-up "lightning" rate=1.5
    element-up "ice" rate=1.5
    element-up "acid" rate=1.5
    element-up "wind" rate=1.5
    element-up "glitter" rate=1.5
}
treasure "toyMouse" name="Cat Toy Mouse" icon="🐭" rarity="legendary" attack=#true text="Every 6 s a big wind-up mouse trundles to the nearest bug and slams into it, hitting everything around it hard." {
    toy-mouse every=6 dmg=9 speed=0.3 size=3.5 splash=0.24 push=0.025
}

// --- more combinations of the words above (no new code)
treasure "spareChange" name="Spare Change" icon="💰" rarity="common" text="+3 Luck for every treasure found this run." stack=3 {
    per "luck" 3 every=1 of="chests"
}
treasure "teaBag" name="Tea Bag" icon="🍵" rarity="common" text="+0.05 Health regen for every Level gained this run." stack=3 {
    per "health-regen" 0.05 every=1 of="levels"
}
treasure "flySwatter" name="Fly Swatter" icon="🪰" rarity="rare" attack=#true text="10% of hits are critical (3x damage) and pin the bug for 0.4 s." stack=2 {
    crit chance=0.1 mult=3
    pin-on-crit 0.4
}

// --- jumps and tentacles (stat): stats that nothing raised before
treasure "insole" name="Spring Insole" icon="👟" rarity="common" text="+25% Jump height." stack=3 {
    stat jump-height 25 percent=#true
}
treasure "spaghetti" name="Spaghetti Strand" icon="🍝" rarity="common" attack=#true text="+2 Tentacles lash out at once." stack=5 {
    stat tentacles 2
}
treasure "tapeMeasure" name="Tape Measure" icon="📏" rarity="common" attack=#true text="+75% Tentacle reach." stack=3 {
    stat tentacle-reach 75 percent=#true
}
treasure "chopsticks" name="Chopsticks" icon="🥢" rarity="common" attack=#true text="+40% Tentacle speed." stack=3 {
    stat tentacle-speed 40 percent=#true
}
treasure "nettle" name="Stinging Nettle" icon="🌿" rarity="common" attack=#true text="+4 Tentacle damage." stack=5 {
    stat tentacle-damage 4
}

// --- timers and big targets
treasure "windUpKey" name="Wind-Up Key" icon="🔑" rarity="rare" text="20% more treasures appear in the room." stack=3 {
    more-treasures 20
}
treasure "canOpener" name="Can Opener" icon="🥫" rarity="rare" text="Everything you do hurts Elites and the Boss 15% more." stack=3 {
    elite-damage 15
}
