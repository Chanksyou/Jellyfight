    }
    level 3 text="On landing: a shockwave hits bugs within 60 cm for 12.6x Attack damage. Not Elites or the Boss." {
        landing-shockwave 0.6 dmg=7 drop=0.04
    }
}
// pure control (no damage): Windowsill Cactus is the one that hurts back
