// Treasures: lost things you keep for the rest of the run, picked from gift boxes
// and beaten elites. Each is a name, an icon, the line the pick screen shows, and effect words;
// every word is defined once in src/words.js (TREASURE_WORDS) with what its numbers mean.
// Damage numbers are multiples of your power (pop damage x 1.8) unless a word says otherwise.
// Tentacles aren't improved by treasures (the Stinging Frills evolution is the way).
//
//   attack=#true   it changes how you attack: the starting pick always offers one of these
//   rarity="…"     common, rare, epic or legendary: how often it's offered (stats.js
//                  TREASURE_RARITY; Luck shifts the odds up). Rate damage treasures with
//                  tests/clear.mjs (x faster at clearing 10 clumped cockroaches: legendary 3.5x+,
//                  epic 2x+, rare 1.4x+); rate the rest by how unique the effect is.
//   stack=N        you can own up to N copies and their effects add up (default 1: unique).
//                  Keep stacking for plain number boosts.
//   level 2 text="…" { words }, level 3 …   a treasure with its own trick can level up instead:
//                  take it again for its next level (only ever the one after the level you have),
//                  each level being its whole word list. The pick card shows its text.
//
// A new treasure that combines existing words needs no code: add it here and a story.

// --- your bubbles (bubbles.js)
treasure "bobbyPin" name="Bobby Pin" icon="🧷" rarity="rare" attack=#true text="Bubbles pierce, popping on up to 3 enemies in a line." {
    pierce 3
    level 2 text="Level 2: pierce up to 4 enemies." {
        pierce 4
    }
    level 3 text="Level 3: pierce up to 5 enemies." {
        pierce 5
    }
}
treasure "hairTie" name="Hair Tie" icon="➰" rarity="rare" attack=#true text="Each bubble that pops blows a smaller one at another enemy nearby." {
    split-bubble
}
treasure "goldRing" name="Gold Ring" icon="💍" rarity="common" text="Every 10th bubble is golden and does 5x damage." {
    golden-bubble every=10 mult=5
    level 2 text="Level 2: every 8th bubble is golden." {
        golden-bubble every=8 mult=5
    }
    level 3 text="Level 3: every 7th bubble is golden, for 6x damage." {
        golden-bubble every=7 mult=6
    }
}
treasure "reedStick" name="Reed Stick" icon="🎋" rarity="epic" attack=#true text="Every 6th bubble brings a giant, slow one that pops for a big splash." {
    giant-bubble every=6 size=2.5 dmg=4 speed=0.6
    level 2 text="Level 2: a giant one every 5th bubble." {
        giant-bubble every=5 size=2.5 dmg=4 speed=0.6
    }
    level 3 text="Level 3: a bigger giant every 4th bubble, 5x damage." {
        giant-bubble every=4 size=2.8 dmg=5 speed=0.6
    }
}

// --- elements for your bubbles (bubbles.js); they stack, and each has three levels (stack=3):
// take the same one again and it gets stronger (bubbles.js LEVEL)
treasure "candle" name="Birthday Candle" icon="🕯️" rarity="rare" attack=#true stack=3 text="Fire bubbles: enemies burn for 3 s. Fire on a frozen enemy shatters it for triple damage. Levels 2-3: burns 1.5x / 2x as hard, for 4 / 5 s." {
    element "fire"
}
treasure "battery" name="AA Battery" icon="🔋" rarity="rare" attack=#true stack=3 text="Lightning bubbles: every pop arcs to 3 more enemies nearby, stunning each. Levels 2-3: arcs to 4 / 5, harder, longer stuns." {
    element "lightning"
}
treasure "freezerPack" name="Freezer Pack" icon="❄️" rarity="rare" attack=#true stack=3 text="Ice bubbles: hits chill and slow; the 2nd chilled hit freezes the enemy solid. Levels 2-3: longer chills, +15% / +30% hit damage." {
    element "ice"
}
treasure "nailPolish" name="Nail Polish" icon="💅" rarity="rare" attack=#true stack=3 text="Acid bubbles: pops leave a puddle that eats at anything standing in it. Levels 2-3: bigger, longer puddles that eat 1.5x / 2x as fast." {
    element "acid"
}
treasure "paperFan" name="Paper Fan" icon="🌬️" rarity="common" attack=#true stack=3 text="Wind bubbles: whatever they hit gets blown backward. Levels 2-3: blown harder, and bubbles pierce one more enemy each level." {
    element "wind"
}
treasure "glitter" name="Glitter" icon="✨" rarity="rare" attack=#true stack=3 text="Glitter bubbles: the splash is twice as wide and hits harder. Levels 2-3: wider still, 1.4x / 1.8x as hard." {
    element "glitter"
}

