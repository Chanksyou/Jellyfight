// --- trade-offs and slow growers (in the spirit of Brotato's items)
treasure "shotGlass" name="Shot Glass" icon="🥃" rarity="common" attack=#true text="Glass cannon: +40% pop damage, but hits take 25% more moisture." {
    stat pop 40 percent=#true
    damage-taken 1.25
}
treasure "chili" name="Hot Chili" icon="🌶️" rarity="common" attack=#true text="+25% pop damage and +10% blow rate, but bubbles reach 15% less far." {
    stat pop 25 percent=#true
    stat blow-rate 10 percent=#true
    stat range -15 percent=#true
}
treasure "flipFlop" name="Flip Flop" icon="🩴" rarity="common" text="Swim 20% faster, but -4 max moisture." stack=2 {
    stat swim-speed 20 percent=#true
