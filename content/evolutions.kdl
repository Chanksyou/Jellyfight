// Evolutions: what the jelly becomes after an act's boss (the metamorphosis). Pick 1 of 3; each is
// taken once a run and kept to the end. With jelly types (GAME.types) there is no separate pick:
// they are Legendary treasures in the Boss reward's pick (Run.pickLegendary), a run can hold
// several, and their costs add up. not-for= leaves one out for the attacks it does nothing for. They're meant to change how you play, not just add numbers:
// each has its own trick, a cost, and an adorn piece that shows on the jelly (src/adornments.js),
// on top of the player's own look, which they never change.
//
// The same effect words as treasures (src/words.js, TREASURE_WORDS); damage numbers are multiples of
// your power (attack damage x 1.8) unless a word says otherwise.
//
//   evolution "id" name="…" icon="…" text="…" { effect words… }

evolution "cinder" name="Cinder Jelly" icon="👣" text="Walking leaves a trail for 3 s that hits bugs on it for 0.9x Attack damage a second. -20% Range and Tentacle reach." {
    fire-trail time=3 radius=0.03 height=0.05 dps=0.5 tick=0.25
    stat range -20 percent=#true
    stat tentacle-reach -20 percent=#true
    adorn "flaming-feet"
}

// (not-for: Element shots keep their own flight (bubbles.js: a tinted shot never rebounds), and tentacles throw nothing: only Normal's bubbles return)
evolution "rebound" name="Rebound Jelly" icon="🔁" not-for="fire lightning ice poison wind glitter tentacle" text="Attacks come back, hitting each bug once each way. Move to steer them. -20% Fire rate." {
    rebound
    stat fire-rate -20 percent=#true
    adorn "rebound-bands"
}

evolution "mirage" name="Mirage Jelly" icon="👻" text="Every 8 s of moving: a ghost for 4 s that bugs within 45 cm aim at. -15% max Health. Not Elites, the Boss or locked attacks." {
    decoy every=8 time=4 range=0.45
    stat health -15 percent=#true
    adorn "mirage-rim"
}

// retired: Bubble Wrap and the Shield stat do its job (a Shield that bursts when it breaks)
evolution "aegis" name="Aegis Jelly" icon="🛡️" retired=#true text="+5 Shield. When your Shield breaks: a Blast hits bugs within 20 cm for 15 damage." {
    stat shield 5
    shield-burst dmg=15 radius=0.2 flat=#true
}

evolution "manOWar" name="Man o' War" icon="⛵" not-for="tentacle" text="2 polyps circle you and fire your attack for 30% of the hit. -15% max Health." {
    polyps 2 dmg=0.3
    stat health -15 percent=#true
    adorn "sail"
}
evolution "immortal" name="Immortal Jelly" icon="♾️" text="Once per act: a hit that would kill you makes you a polyp for 5 s, then gives you full Health. As a polyp you can't be hurt or attack. -10% max Health and no Health regen after." {
    rebirth time=5
    stat health -10 percent=#true
    no-regen revived=#true
    adorn "halo"
}
// the surge is the trick, not a ring round you (Guitar Pick is the pulse): bugs in the way are stung and shoved aside
evolution "moonJelly" name="Moon Jelly" icon="🌙" text="Every 2 s: a surge forward hits bugs you pass within 5 cm for 3.6x Attack damage and shoves them aside. -30% Range." {
    every 2 {
        dash 1.2 time=0.35 dmg=2 push=0.06 reach=0.05
    }
    stat range -30 percent=#true
    stat tentacle-reach -30 percent=#true
    adorn "moon-ring"
}
evolution "lionsMane" name="Lion's Mane" icon="🦁" text="+60% max Health. Every 0.25 s: hits bugs touching you for 0.9x Attack damage. -20% Move speed." {
    stat health 60 percent=#true
    touch-sting dmg=0.5 every=0.25 reach=0.08
    stat move-speed -20 percent=#true
    adorn "mane"
}
evolution "upsideDown" name="Upside-down Jelly" icon="🙃" text="After 1 s standing still: +80% Fire rate, +5 Health every 5 s and attacks pierce 1 more bug." {
    while "rooted" "fire-rate" 80 percent=#true
    while "rooted" "health-regen" 1
    while "rooted" "pierce" 1
    adorn "fronds"
}
