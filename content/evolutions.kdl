// Evolutions: what the jelly becomes after an act's boss (the metamorphosis). Pick 1 of 3; each is
// taken once a run and kept to the end. They're meant to change how you play, not just add numbers:
// each has its own trick, a cost, and an adorn piece that shows on the jelly (src/adornments.js),
// on top of the player's own look, which they never change.
//
// The same effect words as treasures (src/words.js, TREASURE_WORDS); damage numbers are multiples of
// your power (bubble damage x 1.8) unless a word says otherwise.
//
//   evolution "id" name="…" icon="…" text="…" { effect words… }

evolution "cinder" name="Cinder Jelly" icon="👣" text="Flaming feet burn the ground you walk over for 3 seconds, dealing half your power per second to bugs touching the trail. No trail in the air. Range is 20% lower." {
    fire-trail time=3 radius=0.03 height=0.05 dps=0.5 tick=0.25
    stat range -20 percent=#true
    adorn "flaming-feet"
}

evolution "rebound" name="Rebound Jelly" icon="🪃" text="Ordinary bubbles return, hitting each bug once each way. Move to guide them. -20% Fire rate." {
    rebound
    stat fire-rate -20 percent=#true
    adorn "rebound-bands"
}

evolution "mirage" name="Mirage Jelly" icon="👻" text="Every 8 seconds of movement, leave a ghost of your jelly for 4 seconds. Bugs within 45 cm aim at it; locked attacks and Elites still threaten you. Maximum Health is 15% lower." {
    decoy every=8 time=4 range=0.45
    stat health -15 percent=#true
    adorn "mirage-rim"
}

evolution "aegis" name="Aegis Jelly" icon="🛡️" text="An energy shield absorbs 5 damage. When depleted, it explodes for 15 damage within 20 cm, then returns after 5 seconds. Excess damage passes through to Health." {
    energy-shield 5 dmg=15 radius=0.2 recharge=5
}

evolution "boxJelly" name="Box Jelly" icon="🟦" text="Your tentacles become your weapon: 4 tentacles reach twice as far, and every sting stacks venom that burns (up to 5 stacks). Bubbles blow 35% slower." {
    stat tentacles 3
    stat tentacle-reach 100 percent=#true
    venom dps=0.5 time=3 stacks=5
    stat fire-rate -35 percent=#true
    adorn "venom-tips"
}
evolution "manOWar" name="Man o' War" icon="🫧" text="Two polyps circle you and shoot with you: every bubble and element shot, each fires one more at 30% damage. -15% max Health." {
    polyps 2 dmg=0.3
    stat health -15 percent=#true
    adorn "sail"
}
evolution "immortal" name="Immortal Jelly" icon="♾️" text="Once per act, survive a killing blow: become a polyp, invulnerable and unable to attack for 5 s, then recover full Health. -10% max Health. Once you've been a polyp, no more Health regen this run." {
    rebirth time=5
    stat health -10 percent=#true
    no-regen revived=#true
    adorn "halo"
}
evolution "moonJelly" name="Moon Jelly" icon="🌙" text="Every 2 s your bell pulses: a shockwave stings and knocks back everything close, and you surge forward. Bubbles reach 30% less far." {
    every 2 {
        ring 0.24 dmg=2 push=0.08 color="#dff4ff" show=0.4
        dash 0.8 time=0.35
    }
    stat range -30 percent=#true
    adorn "moon-ring"
}
evolution "lionsMane" name="Lion's Mane" icon="🦁" text="+60% max Health, and bugs touching you get stung four times a second. -20% Move speed." {
    stat health 60 percent=#true
    touch-sting dmg=0.5 every=0.25 reach=0.08
    stat move-speed -20 percent=#true
    adorn "mane"
}
evolution "upsideDown" name="Upside-down Jelly" icon="🙃" text="Stand still for a second to root: +80% Fire rate, +1 Health a second, and bubbles pierce one more bug. Move and it's gone." {
    while "rooted" "fire-rate" 80 percent=#true
    while "rooted" "health-regen" 1
    while "rooted" "pierce" 1
    adorn "fronds"
}
