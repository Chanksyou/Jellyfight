// Attack upgrades: each jelly type's own pool (docs/jelly-types/types/<type>.md). After each of the
// first three bosses a run is offered 1 of 3 from its jelly's pool, without ones already taken
// (Run.pickUpgrade). They use the treasures' effect words (src/words.js) and feed the run's combined
// effects like treasures, but are never in a chest, and each is one of a kind.
// needs="…": another upgrade of the same jelly that must be taken first.
//
//   upgrade "id" jelly="…" name="…" icon="…" text="…" needs="…" { effect words… }

// --- Fire: escalation and risk (docs/jelly-types/types/fire.md). Numbers are starting values.
upgrade "flashpoint" jelly="fire" name="Flashpoint" icon="🧨" text="Hits on a Burning bug Blast for 50% of the hit to bugs within 4 cm." {
    status-damage "burning" more=0 elites=#true blast=0.04 blast-dmg=0.5
}
upgrade "slowBurn" jelly="fire" name="Slow Burn" icon="🕯️" text="Burn stacks 3 times and lasts 6 s." {
    element-up "fire" burnStacks=3 burnTime=3
}
upgrade "fireBreath" jelly="fire" name="Fire Breath" icon="🐉" text="Every 4 s: a flame cone at the nearest bug hits and Burns everything in it." {
    every 4 {
        cone range=0.12 angle=70 dmg=0.5
    }
}
// spread fire already spreads again when its bug dies burning (bubbles.js effects)
upgrade "wildfire" jelly="fire" name="Wildfire" icon="🌋" text="Burning bugs that die set bugs 2x as far away Burning, and that fire spreads again." {
    element-up "fire" spread=2
}
upgrade "hotHead" jelly="fire" name="Hot Head" icon="🥵" text="Below half Health: Burn does 2x damage." {
    while "low-health" "burn-damage" 1 under=0.5
}
// most=1: the spec's +20% a second, capped at double (uncapped it grows without end on a boss)
upgrade "stoke" jelly="fire" name="Stoke" icon="🌲" text="Burn grows 20% each second it lasts, up to 2x." {
    burn-ramp 0.2 most=1
}
// only Slow Burn lets a bug hold 3 Burns, so Inferno is offered after it
upgrade "inferno" jelly="fire" name="Inferno" icon="☄️" needs="slowBurn" text="A bug that dies with 3 Burns erupts in a ring of fire." {
    on-kill-of status="burning" stacks=3 {
        ring 0.07 dmg=1.5 color="#ff8a3a"
    }
}
upgrade "backdraft" jelly="fire" name="Backdraft" icon="🚪" text="5 Burning bugs dying within 3 s: a fire Blast around you." {
    streak 5 within=3 status="burning" {
        ring 0.12 dmg=2 color="#ff8a3a"
    }
}
upgrade "fuel" jelly="fire" name="Fuel" icon="⛽" text="+5% Fire rate per Burning bug within 30 cm, up to +25%." {
    per "fire-rate" 5 percent=#true of="burning-nearby" most=5
}
upgrade "blueFlame" jelly="fire" name="Blue Flame" icon="💙" text="Burn does 50% more damage. You take 10% more damage." {
    element-up "fire" burn=1.5
    damage-taken 1.1
}
upgrade "flareUp" jelly="fire" name="Flare Up" icon="🎇" text="Hitting a Burning bug refreshes every Burn." {
    refresh-all "burning"
}
upgrade "melt" jelly="fire" name="Melt" icon="🧈" text="Burning Elites and the Boss take 20% more damage from hits." {
    status-damage "burning" more=0.2 elites=#true bugs=#false
}

// --- Ice: control and defence (docs/jelly-types/types/ice.md). Numbers are starting values.
// Deep Freeze and Avalanche act on Frozen bugs, which only Permafrost makes, so they come after it.
upgrade "permafrost" jelly="ice" name="Permafrost" icon="⛸️" text="3 hits in a row on a Chilled bug: it's Frozen for 1.5 s." {
    chill-to-freeze 3 time=1.5
}
upgrade "brittle" jelly="ice" name="Brittle" icon="🔨" text="Chilled bugs, Elites and Bosses take 40% more damage." {
    status-damage "chilled" more=0.4 elites=#true
}
upgrade "shatterShards" jelly="ice" name="Shatter Shards" icon="💎" text="A Chilled bug that dies bursts into 4 shards that hit and Chill nearby bugs." {
    on-kill-of status="chilled" {
        shards 4 range=0.12 dmg=0.5
    }
}
upgrade "coldSnap" jelly="ice" name="Cold Snap" icon="☃️" text="Every 6 s: a frost ring hits and Chills bugs within 15 cm." {
    every 6 {
        ring 0.15 chill=2 color="#9fe8ff"
    }
}
upgrade "glacierShell" jelly="ice" name="Glacier Shell" icon="🐢" text="Shield refills 2x as fast while a Chilled bug is within 15 cm." {
    shield-recharge faster=1 near=0.15
}
upgrade "icicleLance" jelly="ice" name="Icicle Lance" icon="🗡️" text="Shards pierce Chilled bugs." {
    element-up "ice" chillPierce=1
}
upgrade "frostbite" jelly="ice" name="Frostbite" icon="🌡️" text="Chill also hurts: 20% of the hit's damage a second." {
    element-up "ice" frostbite=0.2
}
upgrade "hoarfrost" jelly="ice" name="Hoarfrost" icon="🌨️" text="Chilled bugs can't jump, fly up or climb." {
    ground-lock "chilled"
}
upgrade "snowball" jelly="ice" name="Snowball" icon="⛄" text="Shards pierce 2 more bugs, growing 10% with each." {
    element-up "ice" pierce=2 grow=0.1
}
upgrade "deepFreeze" jelly="ice" name="Deep Freeze" icon="🥶" needs="permafrost" text="The next hit on a Frozen bug does 3x damage and thaws it." {
    status-damage "frozen" more=2 thaw=#true
}
upgrade "cryoSleep" jelly="ice" name="Cryo Sleep" icon="😴" text="When your Shield breaks: you can't be hurt for 1 s." {
    shield-burst dmg=0 invuln=1
}
upgrade "avalanche" jelly="ice" name="Avalanche" icon="🏔️" needs="permafrost" text="A hit on a Frozen bug slides it 12 cm, Chilling every bug it hits." {
    slide-on-hit "frozen" distance=0.12
}

// --- Tentacle: close range (docs/jelly-types/types/tentacle.md). The first six rework the old tentacle
// Treasures (content/treasures.kdl, retired with jelly types on) and keep their names and icons.
// Numbers are starting values. Tentacle damage is Attack damage here, so "Attack damage" in the text.
upgrade "stingingNettle" jelly="tentacle" name="Stinging Nettle" icon="🌿" text="Stings Bleed: 25% of Attack damage a second for 3 s, up to 5 stacks." {
    venom dps=0.25 time=3 stacks=5
}
upgrade "tapeMeasureReel" jelly="tentacle" name="Tape Measure" icon="📏" text="+60% Tentacle reach. Every 2 s: grab the toughest bug within 30 cm and reel it in for 3x damage, hitting bugs on the way." {
    stat tentacle-reach 60 percent=#true
    every 2 {
        grab range=0.3 dmg=3
    }
}
upgrade "spaghettiSweep" jelly="tentacle" name="Spaghetti Strand" icon="🍝" text="Every 4th lash stings every bug in reach." {
    nth-attack 4 {
        sweep
    }
}
upgrade "toasterCord" jelly="tentacle" name="Toaster Cord" icon="🍞" text="When hit: every tentacle lashes everything in reach for 2x damage." {
    when-hit cooldown=0.2 {
        lash all=#true dmg=2
    }
}
upgrade "chopstickRush" jelly="tentacle" name="Chopsticks" icon="🥢" text="Each kill: +10% Fire rate for 3 s, up to 5 stacks." {
    stack-buff "kill" "fire-rate" 10 percent=#true time=3 stacks=5
}
upgrade "paperclipHop" jelly="tentacle" name="Paperclip Chain" icon="📎" text="Each sting jumps to a second bug in reach for 60% damage." {
    echo-bubble by="tentacles" dmg=0.6
}
upgrade "whipCrack" jelly="tentacle" name="Whip Crack" icon="💢" text="Stings at the edge of your reach do 2x damage." {
    reach-sweetspot from=0.75 mult=2
}
upgrade "anchor" jelly="tentacle" name="Anchor" icon="⚓" text="After 1 s standing still: +50% Attack damage." {
    while "rooted" "bubble-damage" 50 percent=#true
}
upgrade "inkCloud" jelly="tentacle" name="Ink Cloud" icon="🦑" text="When hit: for 2 s, nearby bugs miss half the time." {
    when-hit cooldown=2 {
        ink radius=0.15 time=2 miss=0.5
    }
}
upgrade "venomSac" jelly="tentacle" name="Venom Sac" icon="🦂" text="Every 20 stings: your next lash stings every bug in reach with 3 Bleed stacks." {
    sting-count 20 {
        sweep bleed=3
    }
}
upgrade "coil" jelly="tentacle" name="Coil" icon="➰" text="A bug stung 5 times within 2 s is held still for 1 s." {
    pin-on-stings 5 within=2 seconds=1
}
upgrade "bellPulse" jelly="tentacle" name="Bell Pulse" icon="🔔" text="Every 3 s: one lash reaches 2x as far." {
    every 3 {
        reach-flare 2
    }
}

// --- Poison: stacks, weakening, spreading Poison, healing from Poisoned kills (docs/jelly-types/types/poison.md).
// Numbers are starting values. Wither and Venom Strike say it with status-damage's per-stack (hits only, not Poison itself)
upgrade "wither" jelly="poison" name="Wither" icon="🥀" text="Each Poison stack on a bug: +6% damage to it, Elites and the Boss too." {
    status-damage "poisoned" more=0 per-stack=0.06 elites=#true
}
upgrade "lingeringDose" jelly="poison" name="Lingering Dose" icon="⏳" text="Poison lasts 2x as long: 10 s." {
    element-up "poison" poisonTime=2
}
upgrade "overdose" jelly="poison" name="Overdose" icon="💉" text="Poison stacks up to 10, not 5." {
    element-up "poison" poisonStacks=2
}
upgrade "splatter" jelly="poison" name="Splatter" icon="💦" text="Your blob's burst is 50% wider." {
    element-up "poison" width=1.5
}
upgrade "venomStrike" jelly="poison" name="Venom Strike" icon="🐍" text="Your blob's hit: +20% per Poison stack on the bug." {
    status-damage "poisoned" more=0 per-stack=0.2 by="poison" elites=#true
}
upgrade "wasteAway" jelly="poison" name="Waste Away" icon="🦴" text="Poisoned bugs lose 1% max Health a second, Elites too." {
    percent-dot "poisoned" share=0.01
}
upgrade "toxicCloud" jelly="poison" name="Toxic Cloud" icon="🌫️" text="A Poisoned bug that dies leaves a 5 cm Poison cloud for 3 s." {
    on-kill-of status="poisoned" {
        cloud radius=0.05 time=3
    }
}
upgrade "burstSac" jelly="poison" name="Burst Sac" icon="💣" text="A Poisoned bug that dies passes its Poison stacks to bugs within 6 cm." {
    on-kill-of status="poisoned" {
        pass-stacks "poisoned" radius=0.06
    }
}
upgrade "leech" jelly="poison" name="Leech" icon="🩸" text="+1 Health per Poisoned bug that dies, up to 3 a second." {
    on-kill-of status="poisoned" {
        heal 1 most=3
    }
}
upgrade "contagion" jelly="poison" name="Contagion" icon="🦠" text="Bugs touching a Poisoned bug get a Poison stack." {
    spread-on-touch "poisoned"
}
upgrade "poisonRain" jelly="poison" name="Poison Rain" icon="🌧️" text="Every 8 s: 4 Poison blobs fall on bugs within 30 cm." {
    every 8 {
        blob count=4 range=0.3
    }
}
upgrade "splitBlob" jelly="poison" name="Split Blob" icon="🧫" text="After a hit, your blob splits in two that fly on, each for half damage." {
    split-on-hit 2 dmg=0.5
}

// --- Glitter: chance, Luck, Crits, random effects and XP (docs/jelly-types/types/glitter.md). Numbers are starting values.
upgrade "prism" jelly="glitter" name="Prism" icon="🔺" text="Each burst fires 3 rainbow shots at the nearest bugs, 30% damage each." {
    echo-bubble from="splash" count=3 dmg=0.3
}
upgrade "rainbow" jelly="glitter" name="Rainbow" icon="🌈" text="Each bomb rolls a colour: red Burns, blue Chills, yellow Stuns, for 1.5 s." {
    random-status statuses="burning chilled stunned" time=1.5
}
upgrade "luckySparkle" jelly="glitter" name="Lucky Sparkle" icon="🍀" text="15% of bursts Crit for 3x damage." {
    crit by="splash" chance=0.15 mult=3
}
upgrade "confettiPop" jelly="glitter" name="Confetti Pop" icon="🎊" text="Splash kills pop into confetti that splashes again at half damage." {
    on-kill-of by="splash" {
        splash dmg=0.5
    }
}
upgrade "midasTouch" jelly="glitter" name="Midas Touch" icon="👑" text="1 in 20 splashed bugs: turned to gold and held for 3 s, then bursts into 5 small glitter bombs." {
    gild chance=0.05 time=3 bombs=5
}
upgrade "discoBomb" jelly="glitter" name="Disco Bomb" icon="🕺" text="Every 8 s: your next bomb splashes 3x as wide." {
    every 8 {
        next-attack width=3
    }
}
upgrade "mirrorGlitter" jelly="glitter" name="Mirror Glitter" icon="🔆" text="A burst that reaches a wall bounces off and goes off again." {
    splash-reflect
}
// kills=10: one splash killing 10 is rare in act 1, likelier with Hot Streak and Disco Bomb
upgrade "wish" jelly="glitter" name="Wish" icon="🌠" text="Once per act: a splash that kills 10 bugs gives a free level-up." {
    wish 10
}
upgrade "jackpot" jelly="glitter" name="Jackpot" icon="🎰" text="1 in 100 kills: an XP gem worth the rest of your Level." {
    crumb-on-kill drop="level" chance=0.01
}
// "until a splash kills fewer" said with stack-buff's time: each big splash adds 50% Attack size for 4 s, up to 3
upgrade "hotStreak" jelly="glitter" name="Hot Streak" icon="📈" text="A splash that kills 3+ bugs: bombs 50% bigger for 4 s, up to 3 stacks." {
    stack-buff "big-splash" "bubble-size" 50 percent=#true time=4 stacks=3
}
upgrade "partyPopper" jelly="glitter" name="Party Popper" icon="🎉" text="1 in 10 bombs: giant, splashing for 3x damage." {
    nth-attack 10 random=#true {
        big dmg=3 size=2
    }
}
upgrade "starBurst" jelly="glitter" name="Star Burst" icon="🌟" text="A burst that reaches 5+ bugs fires a star shot at each, 50% damage." {
    splash-shots min=5 dmg=0.5
}
// --- Wind: movement, pushes, Dodge, jumps and landings (docs/jelly-types/types/wind.md). Numbers are starting values.
upgrade "cyclone" jelly="wind" name="Cyclone" icon="🌪️" text="Every 5 s: a whirlwind at the nearest bug within 30 cm pulls bugs together for 1.6 s." {
    every 5 {
        whirl radius=0.09 time=1.6 pull=0.12 range=0.3
    }
}
upgrade "bowling" jelly="wind" name="Bowling" icon="🎳" text="Bugs your Gust shoves knock over bugs in their way, for the same damage." {
    pushed-hits
}
upgrade "tailwind" jelly="wind" name="Tailwind" icon="🍃" text="Each Gust that hits: +30% Move speed for 2 s." {
    stack-buff "hit" "move-speed" 30 percent=#true time=2 stacks=1
}
upgrade "updraft" jelly="wind" name="Updraft" icon="🪁" text="On landing: wind pushes bugs within 12 cm away." {
    landing-shockwave 0.12 dmg=0 push=0.06
}
upgrade "gale" jelly="wind" name="Gale" icon="💨" text="Gusts pierce every bug, losing 20% damage per bug." {
    element-up "wind" pierce=99 falloff=0.2
}
upgrade "slipstream" jelly="wind" name="Slipstream" icon="🏄" text="+20% Dodge at full speed." {
    while "moving" "dodge" 20
}
upgrade "crosswind" jelly="wind" name="Crosswind" icon="🧭" text="Each Gust fires a second one 30° to the side." {
    element-up "wind" count=1 angle=30
}
upgrade "eyeOfTheStorm" jelly="wind" name="Eye of the Storm" icon="👁️" text="Every 2 s: bugs within 6 cm are pushed away." {
    every 2 {
        ring 0.06 dmg=0 push=0.04
    }
}
upgrade "slamDunk" jelly="wind" name="Slam Dunk" icon="🏀" text="Bugs your Gust slams into furniture take 3x the hit, not 1x." {
    element-up "wind" collision=3
}
upgrade "secondWind" jelly="wind" name="Second Wind" icon="🎐" text="Once per act, when hit at 30% Health or less: wind throws everything back, and +50% Move speed for 5 s." {
    when-hit once-per-act=#true low-health=0.3 {
        ring 0.15 dmg=0 push=0.1
        dash 0.5 time=5
    }
}
upgrade "jetStream" jelly="wind" name="Jet Stream" icon="🚀" text="Gusts fly 50% faster and farther." {
    element-up "wind" speed=1.5 range=1.5
}
upgrade "glide" jelly="wind" name="Glide" icon="🪂" text="Hold jump in the air to drift down. Gusts while drifting push 2x as far." {
    glide fall=0.2 push=2
}

// --- Normal: bubble physics (docs/jelly-types/types/normal.md). Numbers are starting values.
// Popcorn says it with the split-on-hit word Split Blob brought. Pop Chain, Rapid Pop and Bubble Trap act on
// what a bubble hits, the rest on how it flies (src/bubbles.js)
upgrade "doubleBubble" jelly="normal" name="Double Bubble" icon="⚪" text="+1 Attack, with no damage loss for it." {
    stat bubbles 1 no-penalty=#true
}
upgrade "popcorn" jelly="normal" name="Popcorn" icon="🍿" text="A bubble that hits splits into 3 small ones, 30% damage each." {
    split-on-hit 3 dmg=0.3 angle=60
}
upgrade "bubbleTrap" jelly="normal" name="Bubble Trap" icon="🕸️" text="1 in 8 hits: Trap a small bug for 1.5 s." {
    trap-on-hit chance=0.125 time=1.5
}
upgrade "bigBubble" jelly="normal" name="Big Bubble" icon="🔵" text="+50% Attack size and splash." {
    stat bubble-size 50 percent=#true
}
upgrade "homing" jelly="normal" name="Homing" icon="🎯" text="Bubbles curve toward the nearest bug." {
    homing 4
}
upgrade "popChain" jelly="normal" name="Pop Chain" icon="⛓️" text="A bubble popping next to another pops it too, for 50% damage." {
    pop-chain 0.5
}
upgrade "wobble" jelly="normal" name="Wobble" icon="〰️" text="Bubbles zigzag, brushing more bugs." {
    wobble 0.02
}
upgrade "ricochet" jelly="normal" name="Ricochet" icon="↩️" text="Bubbles ricochet off one wall." {
    rebound walls-only=#true times=1
}
upgrade "bubbleChain" jelly="normal" name="Bubble Chain" icon="🔗" text="A bubble that kills flies on to the next bug." {
    echo-bubble on="kill"
}
upgrade "rapidPop" jelly="normal" name="Rapid Pop" icon="🥊" text="Each hit in a row on one bug: +10% damage, up to +50%." {
    focus-ramp 0.1 most=0.5
}
upgrade "bigFinish" jelly="normal" name="Big Finish" icon="🎆" text="Bubbles that reach full Range pop in a 2x wide splash." {
    range-pop 2
}
upgrade "orbit" jelly="normal" name="Orbit" icon="🪐" text="Bubbles that miss circle you once, hitting bugs they touch." {
    orbit-misses
}

// --- Lightning: chains and charge-ups (docs/jelly-types/types/lightning.md). Numbers are starting values.
// The shots' arcs hit 3 more bugs for 41% each and Stun them 0.5 s (content/jellies.kdl).
upgrade "overcharge" jelly="lightning" name="Overcharge" icon="🔋" text="Every 5th shot: a big bolt whose arcs hit 2x as hard and jump 2x as far." {
    nth-attack 5 {
        bolt dmg=2 reach=2
    }
}
upgrade "conductor" jelly="lightning" name="Conductor" icon="🔌" text="Arcs can jump back to bugs already hit, and jump 3 more times." {
    element-up "lightning" revisit=1 chain=3
}
upgrade "staticSkin" jelly="lightning" name="Static Skin" icon="🦔" text="Bugs touching you are zapped and Stunned for 1 s, once every 2 s each." {
    touch-zap dmg=0.6 stun=1 each=2
}
upgrade "stormCell" jelly="lightning" name="Storm Cell" icon="⛈️" text="Stand still 2 s to charge: your next shot strikes every bug within 20 cm of where it lands." {
    charged-shot "rooted" 2 strike=0.2
}
upgrade "thunderclap" jelly="lightning" name="Thunderclap" icon="🥁" text="Stunned bugs take 50% more damage." {
    status-damage "stunned" more=0.5
}
upgrade "ballLightning" jelly="lightning" name="Ball Lightning" icon="🟡" text="Every 6 s: a slow ball of lightning zaps bugs it passes." {
    every 6 {
        orb
    }
}
upgrade "chainReaction" jelly="lightning" name="Chain Reaction" icon="💫" text="A Stunned bug that dies sends bolts to 2 more bugs." {
    on-kill-of status="stunned" {
        zap 2 range=0.16 dmg=1 look="bolt"
    }
}
upgrade "lightningRod" jelly="lightning" name="Lightning Rod" icon="🗼" text="Arcs jump to Stunned bugs first, for 30% more damage." {
    element-up "lightning" stunFirst=1
    status-damage "stunned" more=0.3 by="lightning"
}
upgrade "overload" jelly="lightning" name="Overload" icon="🌩️" text="Every 10 s: a bolt strikes the toughest bug nearby for 5x damage." {
    every 10 {
        zap 1 target="toughest" dmg=5 look="bolt"
    }
}
upgrade "staticCharge" jelly="lightning" name="Static Charge" icon="🏃" text="After 3 s of moving: your next shot arcs to 3 more bugs." {
    charged-shot "moving" 3 chain=3
}
upgrade "surge" jelly="lightning" name="Surge" icon="🌊" text="Each arc: +2% Fire rate for 3 s, up to +20%." {
    stack-buff "arc" "fire-rate" 2 percent=#true time=3 stacks=10
}
upgrade "grounded" jelly="lightning" name="Grounded" icon="🌍" text="Arcs do 2x damage to Elites and the Boss." {
    element-up "lightning" eliteBolt=2
}
