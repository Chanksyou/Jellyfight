// Attack upgrades: each jelly type's own pool (docs/jelly-types/types/<type>.md). After each of the
// first three bosses a run is offered 1 of 3 from its jelly's pool, without ones already taken
// (Run.pickUpgrade). They use the treasures' effect words (src/words.js) and feed the run's combined
// effects like treasures, but are never in a chest, and each is one of a kind.
// needs="…": another upgrade of the same jelly that must be taken first.
//
//   upgrade "id" jelly="…" name="…" icon="…" text="…" needs="…" { effect words… }

// --- Fire: escalation and risk (docs/jelly-types/types/fire.md). Numbers are starting values.
upgrade "flashpoint" jelly="fire" name="Flashpoint" icon="💥" text="A hit on a Burning bug bursts in a small Blast: 50% of the hit to every bug within 4 cm." {
    status-damage "burning" more=0 elites=#true blast=0.04 blast-dmg=0.5
}
upgrade "slowBurn" jelly="fire" name="Slow Burn" icon="🕯️" text="Burn stacks up to 3 times on one bug, and lasts 6 s." {
    element-up "fire" burnStacks=3 burnTime=3
}
upgrade "fireBreath" jelly="fire" name="Fire Breath" icon="🐉" text="Every 4 s a short flame cone roars out at the nearest bug, hitting everything in it and setting it alight." {
    every 4 {
        cone range=0.12 angle=70 dmg=0.5
    }
}
// spread fire already spreads again when its bug dies burning (bubbles.js effects)
upgrade "wildfire" jelly="fire" name="Wildfire" icon="🌋" text="Burning bugs that die set everything twice as far away alight, and that fire spreads again." {
    element-up "fire" spread=2
}
upgrade "hotHead" jelly="fire" name="Hot Head" icon="🥵" text="Below half Health, Burn does double damage." {
    while "low-health" "burn-damage" 1 under=0.5
}
// most=1: the spec's +20% a second, capped at double (uncapped it grows without end on a boss)
upgrade "stoke" jelly="fire" name="Stoke" icon="🪵" text="Burn grows 20% for each second a bug keeps burning, up to double." {
    burn-ramp 0.2 most=1
}
// only Slow Burn lets a bug hold 3 Burns, so Inferno is offered after it
upgrade "inferno" jelly="fire" name="Inferno" icon="☄️" needs="slowBurn" text="A bug that dies with 3 Burns erupts in a ring of fire." {
    on-kill-of status="burning" stacks=3 {
        ring 0.07 dmg=1.5 color="#ff8a3a"
    }
}
upgrade "backdraft" jelly="fire" name="Backdraft" icon="🌬️" text="5 Burning bugs dying within 3 s release a fire Blast around you." {
    streak 5 within=3 status="burning" {
        ring 0.12 dmg=2 color="#ff8a3a"
    }
}
upgrade "fuel" jelly="fire" name="Fuel" icon="⛽" text="+5% Fire rate for each Burning bug within 30 cm, up to +25%." {
    per "fire-rate" 5 percent=#true of="burning-nearby" most=5
}
upgrade "blueFlame" jelly="fire" name="Blue Flame" icon="🔵" text="Burn does 50% more damage, but you take 10% more." {
    element-up "fire" burn=1.5
    damage-taken 1.1
}
upgrade "flareUp" jelly="fire" name="Flare Up" icon="🎇" text="Hitting a Burning bug refreshes the Burn on every Burning bug." {
    refresh-all "burning"
}
upgrade "melt" jelly="fire" name="Melt" icon="🫠" text="Burning Elites and the boss take 20% more damage from hits." {
    status-damage "burning" more=0.2 elites=#true bugs=#false
}

// --- Ice: control and defence (docs/jelly-types/types/ice.md). Numbers are starting values.
// Deep Freeze and Avalanche act on Frozen bugs, which only Permafrost makes, so they come after it.
upgrade "permafrost" jelly="ice" name="Permafrost" icon="🧊" text="3 hits in a row on a Chilled bug freeze it solid for 1.5 s." {
    chill-to-freeze 3 time=1.5
}
upgrade "brittle" jelly="ice" name="Brittle" icon="🔨" text="Chilled bugs take 40% more damage from everything." {
    status-damage "chilled" more=0.4
}
upgrade "shatterShards" jelly="ice" name="Shatter Shards" icon="💎" text="A Chilled bug that dies bursts into 4 shards that hit the bugs nearby and Chill them." {
    on-kill-of status="chilled" {
        shards 4 range=0.12 dmg=0.5
    }
}
upgrade "coldSnap" jelly="ice" name="Cold Snap" icon="❄️" text="Every 6 s a frost ring hits every bug within 15 cm and Chills it." {
    every 6 {
        ring 0.15 chill=2 color="#9fe8ff"
    }
}
upgrade "glacierShell" jelly="ice" name="Glacier Shell" icon="🛡️" text="Your Shield refills twice as fast while a Chilled bug is within 15 cm." {
    shield-recharge faster=1 near=0.15
}
upgrade "icicleLance" jelly="ice" name="Icicle Lance" icon="🗡️" text="Shards fly through every bug that is already Chilled." {
    element-up "ice" chillPierce=1
}
upgrade "frostbite" jelly="ice" name="Frostbite" icon="🧤" text="Chill also hurts: 20% of the hit's damage every second while it lasts." {
    element-up "ice" frostbite=0.2
}
upgrade "hoarfrost" jelly="ice" name="Hoarfrost" icon="🌨️" text="Chilled bugs can't jump, fly up or climb." {
    ground-lock "chilled"
}
upgrade "snowball" jelly="ice" name="Snowball" icon="⛄" text="Shards go through 2 more bugs and grow 10% bigger with each one they hit." {
    element-up "ice" pierce=2 grow=0.1
}
upgrade "deepFreeze" jelly="ice" name="Deep Freeze" icon="🥶" needs="permafrost" text="The next hit on a Frozen bug does 3x damage and thaws it." {
    status-damage "frozen" more=2 thaw=#true
}
upgrade "cryoSleep" jelly="ice" name="Cryo Sleep" icon="😴" text="When your Shield breaks, you freeze over and can't be hurt for 1 s more." {
    shield-burst dmg=0 invuln=1
}
upgrade "avalanche" jelly="ice" name="Avalanche" icon="🏔️" needs="permafrost" text="A hit on a Frozen bug sends it sliding 12 cm, and it Chills every bug it slides into." {
    slide-on-hit "frozen" distance=0.12
}

// --- Tentacle: close range (docs/jelly-types/types/tentacle.md). The first six rework the old tentacle
// Treasures (content/treasures.kdl, retired with jelly types on) and keep their names and icons.
// Numbers are starting values. Tentacle damage is Attack damage here, so "Attack damage" in the text.
upgrade "stingingNettle" jelly="tentacle" name="Stinging Nettle" icon="🌿" text="Stings make bugs Bleed: 25% of your Attack damage a second for 3 s, up to 5 stacks." {
    venom dps=0.25 time=3 stacks=5
}
upgrade "tapeMeasureReel" jelly="tentacle" name="Tape Measure" icon="📏" text="+60% Tentacle reach. Every 2 s a tentacle shoots out up to 30 cm, grabs the toughest bug and reels it in, slamming it for 3x damage and hitting every bug it drags through." {
    stat tentacle-reach 60 percent=#true
    every 2 {
        grab range=0.3 dmg=3
    }
}
upgrade "spaghettiSweep" jelly="tentacle" name="Spaghetti Strand" icon="🍝" text="Every 4th lash stings every bug in reach at once." {
    nth-attack 4 {
        sweep
    }
}
upgrade "toasterCord" jelly="tentacle" name="Toaster Cord" icon="🍞" text="When a bug hits you, every tentacle lashes back at everything in reach for twice the damage (up to 5 times a second)." {
    when-hit cooldown=0.2 {
        lash all=#true dmg=2
    }
}
upgrade "chopstickRush" jelly="tentacle" name="Chopsticks" icon="🥢" text="Each kill gives +10% Fire rate for 3 s, up to 5 stacks." {
    stack-buff "kill" "fire-rate" 10 percent=#true time=3 stacks=5
}
upgrade "paperclipHop" jelly="tentacle" name="Paperclip Chain" icon="📎" text="Each sting jumps on to a second bug in reach for 60% of its damage." {
    echo-bubble by="tentacles" dmg=0.6
}
upgrade "whipCrack" jelly="tentacle" name="Whip Crack" icon="💢" text="Stings at the very edge of your reach do double damage." {
    reach-sweetspot from=0.75 mult=2
}
upgrade "anchor" jelly="tentacle" name="Anchor" icon="⚓" text="After 1 s standing still, +50% Attack damage." {
    while "rooted" "bubble-damage" 50 percent=#true
}
upgrade "inkCloud" jelly="tentacle" name="Ink Cloud" icon="🦑" text="When a bug hits you, you squirt ink: for 2 s, bugs near you miss half the time." {
    when-hit cooldown=2 {
        ink radius=0.15 time=2 miss=0.5
    }
}
upgrade "venomSac" jelly="tentacle" name="Venom Sac" icon="🧪" text="Every 20 stings, your next lash stings every bug in reach and gives each 3 Bleed stacks." {
    sting-count 20 {
        sweep bleed=3
    }
}
upgrade "coil" jelly="tentacle" name="Coil" icon="🪢" text="A bug stung 5 times within 2 s is held in place for 1 s." {
    pin-on-stings 5 within=2 seconds=1
}
upgrade "bellPulse" jelly="tentacle" name="Bell Pulse" icon="🔔" text="Every 3 s your tentacles flare out to twice their reach for one lash." {
    every 3 {
        reach-flare 2
    }
}

// --- Poison: stacks, weakening, spreading Poison, healing from Poisoned kills (docs/jelly-types/types/poison.md).
// Numbers are starting values. Wither and Venom Strike say it with status-damage's per-stack (hits only, not Poison itself)
upgrade "wither" jelly="poison" name="Wither" icon="🥀" text="Each Poison stack on a bug makes your hits on it do 6% more damage, on Elites and the boss too." {
    status-damage "poisoned" more=0 per-stack=0.06 elites=#true
}
upgrade "lingeringDose" jelly="poison" name="Lingering Dose" icon="⏳" text="Poison lasts twice as long: 10 s." {
    element-up "poison" poisonTime=2
}
upgrade "overdose" jelly="poison" name="Overdose" icon="💉" text="Poison stacks up to 10 times on one bug, not 5." {
    element-up "poison" poisonStacks=2
}
upgrade "splatter" jelly="poison" name="Splatter" icon="💦" text="Your blob's burst is 50% wider." {
    element-up "poison" width=1.5
}
upgrade "venomStrike" jelly="poison" name="Venom Strike" icon="🐍" text="Your blob's hit does 20% more for each Poison stack on the bug." {
    status-damage "poisoned" more=0 per-stack=0.2 by="poison" elites=#true
}
upgrade "wasteAway" jelly="poison" name="Waste Away" icon="🦴" text="Poisoned bugs also lose 1% of their max Health a second, Elites too." {
    percent-dot "poisoned" share=0.01
}
upgrade "toxicCloud" jelly="poison" name="Toxic Cloud" icon="☁️" text="A Poisoned bug that dies leaves a 5 cm cloud of gas for 3 s that Poisons every bug inside." {
    on-kill-of status="poisoned" {
        cloud radius=0.05 time=3
    }
}
upgrade "burstSac" jelly="poison" name="Burst Sac" icon="🎈" text="A Poisoned bug that dies bursts, passing its Poison stacks to every bug within 6 cm." {
    on-kill-of status="poisoned" {
        pass-stacks "poisoned" radius=0.06
    }
}
upgrade "leech" jelly="poison" name="Leech" icon="🩸" text="Heal 1 Health for each Poisoned bug that dies, up to 3 a second." {
    on-kill-of status="poisoned" {
        heal 1 most=3
    }
}
upgrade "contagion" jelly="poison" name="Contagion" icon="🦠" text="A bug touching a Poisoned bug gets a Poison stack too." {
    spread-on-touch "poisoned"
}
upgrade "poisonRain" jelly="poison" name="Poison Rain" icon="🌧️" text="Every 8 s, 4 Poison blobs fall on bugs within 30 cm of you." {
    every 8 {
        blob count=4 range=0.3
    }
}
upgrade "splitBlob" jelly="poison" name="Split Blob" icon="🫧" text="After it hits, your blob splits in two halves that fly on, each hitting for half and bursting." {
    split-on-hit 2 dmg=0.5
}

// --- Glitter: chance, Luck, Crits, random effects and XP (docs/jelly-types/types/glitter.md). Numbers are starting values.
upgrade "prism" jelly="glitter" name="Prism" icon="🔺" text="Each burst fires 3 small rainbow shots at the nearest bugs, 30% of the bomb's hit each." {
    echo-bubble from="splash" count=3 dmg=0.3
}
upgrade "rainbow" jelly="glitter" name="Rainbow" icon="🌈" text="Each bomb rolls a colour: red sets bugs burning, blue Chills them, yellow Stuns them, for 1.5 s." {
    random-status statuses="burning chilled stunned" time=1.5
}
upgrade "luckySparkle" jelly="glitter" name="Lucky Sparkle" icon="🍀" text="15% chance a burst Crits, splashing for 3x damage." {
    crit by="splash" chance=0.15 mult=3
}
upgrade "confettiPop" jelly="glitter" name="Confetti Pop" icon="🎊" text="Bugs killed by a splash pop into confetti that splashes again at half damage." {
    on-kill-of by="splash" {
        splash dmg=0.5
    }
}
upgrade "midasTouch" jelly="glitter" name="Midas Touch" icon="👑" text="1 in 20 splashed bugs turns to gold: held still and shining for 3 s, then it bursts into 5 small glitter bombs." {
    gild chance=0.05 time=3 bombs=5
}
upgrade "discoBomb" jelly="glitter" name="Disco Bomb" icon="🪩" text="Every 8 s, your next bomb splashes 3x as wide." {
    every 8 {
        next-attack width=3
    }
}
upgrade "mirrorGlitter" jelly="glitter" name="Mirror Glitter" icon="🪞" text="A burst that reaches a wall goes off once more, thrown back off it." {
    splash-reflect
}
// kills=10: one splash killing 10 is rare in act 1, likelier with Hot Streak and Disco Bomb
upgrade "wish" jelly="glitter" name="Wish" icon="🌠" text="Once each act, a splash that kills 10 bugs gives you a free level-up." {
    wish 10
}
upgrade "jackpot" jelly="glitter" name="Jackpot" icon="🎰" text="1 in 100 kills drops a big XP gem worth the rest of your level." {
    crumb-on-kill drop="level" chance=0.01
}
// "until a splash kills fewer" said with stack-buff's time: each big splash adds 50% Attack size for 4 s, up to 3
upgrade "hotStreak" jelly="glitter" name="Hot Streak" icon="📈" text="A splash that kills 3 or more bugs makes your bombs 50% bigger for 4 s, stacking up to 3 times." {
    stack-buff "big-splash" "bubble-size" 50 percent=#true time=4 stacks=3
}
upgrade "partyPopper" jelly="glitter" name="Party Popper" icon="🎉" text="A random bomb in 10 is giant, splashing for 3x damage." {
    nth-attack 10 random=#true {
        big dmg=3 size=2
    }
}
upgrade "starBurst" jelly="glitter" name="Star Burst" icon="⭐" text="A burst that reaches 5 or more bugs fires a star shot at each, 50% of the bomb's hit." {
    splash-shots min=5 dmg=0.5
}
// --- Wind: movement, pushes, Dodge, jumps and landings (docs/jelly-types/types/wind.md). Numbers are starting values.
upgrade "cyclone" jelly="wind" name="Cyclone" icon="🌪️" text="Every 5 s a whirlwind rises at the nearest bug within 30 cm and pulls every bug in it together for 1.6 s." {
    every 5 {
        whirl radius=0.09 time=1.6 pull=0.12 range=0.3
    }
}
upgrade "bowling" jelly="wind" name="Bowling" icon="🎳" text="A bug your gust shoves knocks over every bug in its way, for the same damage." {
    pushed-hits
}
upgrade "tailwind" jelly="wind" name="Tailwind" icon="🍃" text="Each gust that hits gives +30% Move speed for 2 s." {
    stack-buff "hit" "move-speed" 30 percent=#true time=2 stacks=1
}
upgrade "updraft" jelly="wind" name="Updraft" icon="🌬️" text="Landing from a jump blasts a ring of wind that pushes every bug within 12 cm away." {
    landing-shockwave 0.12 dmg=0 push=0.06
}
upgrade "gale" jelly="wind" name="Gale" icon="💨" text="Gusts blow through every bug in their path, but lose 20% of their damage for each bug." {
    element-up "wind" pierce=99 falloff=0.2
}
upgrade "slipstream" jelly="wind" name="Slipstream" icon="🏄" text="+20% Dodge while you swim at full speed." {
    while "moving" "dodge" 20
}
upgrade "crosswind" jelly="wind" name="Crosswind" icon="🧭" text="Every gust fires a second one off to the side, 30° from the first." {
    element-up "wind" count=1 angle=30
}
upgrade "eyeOfTheStorm" jelly="wind" name="Eye of the Storm" icon="🌀" text="Every 2 s, bugs within 6 cm of you are pushed away." {
    every 2 {
        ring 0.06 dmg=0 push=0.04
    }
}
upgrade "slamDunk" jelly="wind" name="Slam Dunk" icon="🏀" text="A bug your gust slams into furniture takes 3 times the hit, not 1 time." {
    element-up "wind" collision=3
}
upgrade "secondWind" jelly="wind" name="Second Wind" icon="🫁" text="Once an act, when you are hit at 30% Health or less, a ring of wind throws everything back and you get +50% Move speed for 5 s." {
    when-hit once-per-act=#true low-health=0.3 {
        ring 0.15 dmg=0 push=0.1
        dash 0.5 time=5
    }
}
upgrade "jetStream" jelly="wind" name="Jet Stream" icon="🚀" text="Gusts fly 50% faster and 50% farther." {
    element-up "wind" speed=1.5 range=1.5
}
upgrade "glide" jelly="wind" name="Glide" icon="🪂" text="Hold jump in the air to drift down slowly. Gusts blown while you drift push twice as far." {
    glide fall=0.2 push=2
}

// --- Normal: bubble physics (docs/jelly-types/types/normal.md). Numbers are starting values.
// Popcorn says it with the split-on-hit word Split Blob brought. Pop Chain, Rapid Pop and Bubble Trap act on
// what a bubble hits, the rest on how it flies (src/bubbles.js)
upgrade "doubleBubble" jelly="normal" name="Double Bubble" icon="🫧" text="+1 Attack side by side, and the others lose no damage for it." {
    stat bubbles 1 no-penalty=#true
}
upgrade "popcorn" jelly="normal" name="Popcorn" icon="🍿" text="A bubble that pops on a bug splits into 3 small ones that fly on for 30% of its damage each." {
    split-on-hit 3 dmg=0.3 angle=60
}
upgrade "bubbleTrap" jelly="normal" name="Bubble Trap" icon="🪤" text="1 hit in 8 traps a small bug in a bubble that holds it still for 1.5 s." {
    trap-on-hit chance=0.125 time=1.5
}
upgrade "bigBubble" jelly="normal" name="Big Bubble" icon="🔵" text="Attack size and splash +50%." {
    stat bubble-size 50 percent=#true
}
upgrade "homing" jelly="normal" name="Homing" icon="🧲" text="Bubbles curve toward the nearest bug." {
    homing 4
}
upgrade "popChain" jelly="normal" name="Pop Chain" icon="⛓️" text="A bubble popping next to another bubble pops it too, for 50% of its damage." {
    pop-chain 0.5
}
upgrade "wobble" jelly="normal" name="Wobble" icon="〰️" text="Bubbles zigzag in a wide wobble, brushing more bugs on the way." {
    wobble 0.02
}
upgrade "ricochet" jelly="normal" name="Ricochet" icon="↩️" text="Bubbles that hit a wall ricochet off it once." {
    rebound walls-only=#true times=1
}
upgrade "bubbleChain" jelly="normal" name="Bubble Chain" icon="🔗" text="A bubble that kills a bug flies on to the next one." {
    echo-bubble on="kill"
}
upgrade "rapidPop" jelly="normal" name="Rapid Pop" icon="⚡" text="Each hit in a row on the same bug does 10% more, up to +50%." {
    focus-ramp 0.1 most=0.5
}
upgrade "bigFinish" jelly="normal" name="Big Finish" icon="🎆" text="A bubble that reaches the end of its Range pops in a splash twice as wide." {
    range-pop 2
}
upgrade "orbit" jelly="normal" name="Orbit" icon="🪐" text="Bubbles that miss circle you once, hitting the bugs they touch." {
    orbit-misses
}

// --- Lightning: chains and charge-ups (docs/jelly-types/types/lightning.md). Numbers are starting values.
// The shots' arcs hit 3 more bugs for 41% each and Stun them 0.5 s (content/jellies.kdl).
upgrade "overcharge" jelly="lightning" name="Overcharge" icon="🔋" text="Every 5th shot is a big bolt: bigger, its arcs hit twice as hard and jump twice as far." {
    nth-attack 5 {
        bolt dmg=2 reach=2
    }
}
upgrade "conductor" jelly="lightning" name="Conductor" icon="🧲" text="Arcs can jump back to bugs they already hit, and jump 3 more times." {
    element-up "lightning" revisit=1 chain=3
}
upgrade "staticSkin" jelly="lightning" name="Static Skin" icon="🧦" text="Bugs that touch you are zapped and Stunned for 1 s, once every 2 s each." {
    touch-zap dmg=0.6 stun=1 each=2
}
upgrade "stormCell" jelly="lightning" name="Storm Cell" icon="⛈️" text="Stand still for 2 s to charge: your next shot strikes every bug within 20 cm of where it lands." {
    charged-shot "rooted" 2 strike=0.2
}
upgrade "thunderclap" jelly="lightning" name="Thunderclap" icon="🥁" text="Stunned bugs take 50% more damage from everything." {
    status-damage "stunned" more=0.5
}
upgrade "ballLightning" jelly="lightning" name="Ball Lightning" icon="🔮" text="Every 6 s a slow ball of lightning drifts out and zaps every bug it passes." {
    every 6 {
        orb
    }
}
upgrade "chainReaction" jelly="lightning" name="Chain Reaction" icon="💫" text="A Stunned bug that dies sends bolts to 2 more bugs." {
    on-kill-of status="stunned" {
        zap 2 range=0.16 dmg=1 look="bolt"
    }
}
upgrade "lightningRod" jelly="lightning" name="Lightning Rod" icon="🗼" text="Arcs jump to Stunned bugs first, and hit them for 30% more." {
    element-up "lightning" stunFirst=1
    status-damage "stunned" more=0.3 by="lightning"
}
upgrade "overload" jelly="lightning" name="Overload" icon="🌩️" text="Every 10 s a bolt strikes the toughest bug near you for 5x damage." {
    every 10 {
        zap 1 target="toughest" dmg=5 look="bolt"
    }
}
upgrade "staticCharge" jelly="lightning" name="Static Charge" icon="🎈" text="After 3 s of moving, your next shot arcs to 3 more bugs." {
    charged-shot "moving" 3 chain=3
}
upgrade "surge" jelly="lightning" name="Surge" icon="📈" text="Each arc gives +2% Fire rate for 3 s, up to +20%." {
    stack-buff "arc" "fire-rate" 2 percent=#true time=3 stacks=10
}
upgrade "grounded" jelly="lightning" name="Grounded" icon="🌍" text="Arcs hit Elites and the boss twice as hard." {
    element-up "lightning" eliteBolt=2
}
