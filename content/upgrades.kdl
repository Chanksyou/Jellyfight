// Attack upgrades: each jelly type's own pool (docs/jelly-types/types/<type>.md). After each of the
// first three bosses a run is offered 1 of 3 from its jelly's pool, without ones already taken
// (Run.pickUpgrade). They use the treasures' effect words (src/words.js) and feed the run's combined
// effects like treasures, but are never in a chest, and each is one of a kind.
// needs="…": another upgrade of the same jelly that must be taken first.
//
//   upgrade "id" jelly="…" name="…" icon="…" text="…" needs="…" { effect words… }

// --- Fire: escalation and risk (docs/jelly-types/types/fire.md). Numbers are starting values.
upgrade "flashpoint" jelly="fire" name="Flashpoint" icon="🧨" text="On a hit on a Burning bug: a Blast within 8 cm hits other bugs for 75% of the hit." {
    status-damage "burning" more=0 elites=#true blast=0.08 blast-dmg=0.75
}
upgrade "slowBurn" jelly="fire" name="Slow Burn" icon="🕯️" text="Burn stacks up to 3, not 1. Burn runs for 6 s, not 3 s." {
    element-up "fire" burnStacks=3 burnTime=3
}
upgrade "fireBreath" jelly="fire" name="Fire Breath" icon="🐉" text="Every 4 s: a flame cone toward the nearest bug within 12 cm hits bugs in it for 0.9x Attack damage and Burns them." {
    every 4 {
        cone range=0.12 angle=70 dmg=0.5
    }
}
// spread fire already spreads again when its bug dies burning (bubbles.js effects)
upgrade "wildfire" jelly="fire" name="Wildfire" icon="🌋" text="When a Burning bug dies: bugs within 12 cm Burn, not 6 cm." {
    element-up "fire" spread=2
}
upgrade "hotHead" jelly="fire" name="Hot Head" icon="🥵" text="Below 50% Health: +100% Burn damage." {
    while "low-health" "burn-damage" 1 under=0.5
}
// most=1: the spec's +20% a second, capped at double (uncapped it grows without end on a boss)
upgrade "stoke" jelly="fire" name="Stoke" icon="🌲" text="+30% Burn damage per second a bug keeps Burning, up to +200%." {
    burn-ramp 0.3 most=2
}
// only Slow Burn lets a bug hold 3 Burns, so Inferno is offered after it
upgrade "inferno" jelly="fire" name="Inferno" icon="☄️" needs="slowBurn" text="When a bug with 3 Burn stacks dies: a ring hits bugs within 10 cm for 3.6x Attack damage." {
    on-kill-of status="burning" stacks=3 {
        ring 0.1 dmg=2 color="#ff8a3a"
    }
}
upgrade "backdraft" jelly="fire" name="Backdraft" icon="🚪" text="When 4 Burning bugs die within 3 s: a ring hits bugs within 12 cm for 3.6x Attack damage." {
    streak 4 within=3 status="burning" {
        ring 0.12 dmg=2 color="#ff8a3a"
    }
}
upgrade "fuel" jelly="fire" name="Fuel" icon="⛽" text="+10% Fire rate per Burning bug within 30 cm, up to +50%." {
    per "fire-rate" 10 percent=#true of="burning-nearby" most=5
}
upgrade "blueFlame" jelly="fire" name="Blue Flame" icon="💙" text="+75% Burn damage. You take 10% more damage." {
    element-up "fire" burn=1.75
    damage-taken 1.1
}
upgrade "flareUp" jelly="fire" name="Flare Up" icon="🎇" text="On a hit on a Burning bug: refreshes Burn on every Burning bug." {
    refresh-all "burning"
}
upgrade "melt" jelly="fire" name="Melt" icon="🧈" text="Burning Elites and the Boss take 25% more damage." {
    status-damage "burning" more=0.25 elites=#true bugs=#false
}

// --- Ice: control and defence (docs/jelly-types/types/ice.md). Numbers are starting values.
// Deep Freeze and Avalanche act on Frozen bugs, which only Permafrost makes, so they come after it.
upgrade "permafrost" jelly="ice" name="Permafrost" icon="⛸️" text="On a 2nd hit in a row on a Chilled bug: it is Frozen for 2 s. Not Elites or the Boss." {
    chill-to-freeze 2 time=2
}
upgrade "brittle" jelly="ice" name="Brittle" icon="🔨" text="Chilled bugs take 40% more damage. Elites and the Boss too." {
    status-damage "chilled" more=0.4 elites=#true
}
upgrade "shatterShards" jelly="ice" name="Shatter Shards" icon="💎" text="When a Chilled bug dies: 4 shards hit the nearest bugs within 12 cm for 1.35x Attack damage and Chill them for 2 s." {
    on-kill-of status="chilled" {
        shards 4 range=0.12 dmg=0.75
    }
}
upgrade "coldSnap" jelly="ice" name="Cold Snap" icon="☃️" text="Every 4 s: a frost ring hits bugs within 15 cm for 1.8x Attack damage and Chills them for 2 s." {
    every 4 {
        ring 0.15 chill=2 color="#9fe8ff"
    }
}
upgrade "glacierShell" jelly="ice" name="Glacier Shell" icon="🐢" text="Your Shield refills 2x as fast while a Chilled bug is within 15 cm." {
    shield-recharge faster=1 near=0.15
}
upgrade "icicleLance" jelly="ice" name="Icicle Lance" icon="🗡️" text="Ice shards pierce Chilled bugs." {
    element-up "ice" chillPierce=4
}
upgrade "frostbite" jelly="ice" name="Frostbite" icon="🌡️" text="Chill does 30% of the hit a second." {
    element-up "ice" frostbite=0.3
}
upgrade "hoarfrost" jelly="ice" name="Hoarfrost" icon="🌨️" text="Chilled bugs can't jump, fly up or climb." {
    ground-lock "chilled"
}
upgrade "snowball" jelly="ice" name="Snowball" icon="⛄" text="Ice shards pierce 3 more bugs and grow 30% with each." {
    element-up "ice" pierce=3 grow=0.3
}
upgrade "deepFreeze" jelly="ice" name="Deep Freeze" icon="🥶" needs="permafrost" text="On a hit on a Frozen bug: the hit does 3x damage and shatters the ice." {
    status-damage "frozen" more=2 thaw=#true
}
upgrade "cryoSleep" jelly="ice" name="Cryo Sleep" icon="😴" text="When your Shield breaks: you can't be hurt for 1 s." {
    shield-burst dmg=0 invuln=1
}
upgrade "avalanche" jelly="ice" name="Avalanche" icon="🏔️" needs="permafrost" text="On a hit on a Frozen bug: shoves it 12 cm and Chills bugs it hits for 2 s." {
    slide-on-hit "frozen" distance=0.12
}

// --- Tentacle: close range (docs/jelly-types/types/tentacle.md). The first six rework the old tentacle
// Treasures (content/treasures.kdl, retired with jelly types on) and keep their names and icons.
// Numbers are starting values. Tentacle damage is Attack damage here, so "Attack damage" in the text.
upgrade "stingingNettle" jelly="tentacle" name="Stinging Nettle" icon="🌿" text="Stings Bleed: 25% of Attack damage a second for 3 s, up to 5 stacks." {
    venom dps=0.25 time=3 stacks=5
}
upgrade "tapeMeasureReel" jelly="tentacle" name="Tape Measure" icon="📏" text="+60% Tentacle reach. Every 2 s: reels in the toughest bug within 30 cm for 3x Attack damage, hitting bugs on the way. Not the Boss." {
    stat tentacle-reach 60 percent=#true
    every 2 {
        grab range=0.3 dmg=3
    }
}
upgrade "spaghettiSweep" jelly="tentacle" name="Spaghetti Strand" icon="🍝" text="Every 4th lash: stings every bug within reach." {
    nth-attack 4 {
        sweep
    }
}
upgrade "toasterCord" jelly="tentacle" name="Toaster Cord" icon="🍞" text="When hit: lashes every bug within reach for 2x Attack damage." {
    when-hit cooldown=0.2 {
        lash all=#true dmg=2
    }
}
upgrade "chopstickRush" jelly="tentacle" name="Chopsticks" icon="🥢" text="On a kill: +20% Fire rate for 3 s, up to +100%." {
    stack-buff "kill" "fire-rate" 20 percent=#true time=3 stacks=5
}
upgrade "paperclipHop" jelly="tentacle" name="Paperclip Chain" icon="📎" text="On a hit: the sting jumps once to the nearest other bug within reach, for 60% of the hit." {
    echo-bubble by="tentacles" dmg=0.6
}
upgrade "whipCrack" jelly="tentacle" name="Whip Crack" icon="💢" text="Stings in the outer quarter of your reach do 2x damage." {
    reach-sweetspot from=0.75 mult=2
}
upgrade "anchor" jelly="tentacle" name="Anchor" icon="⚓" text="After 1 s standing still: +75% Attack damage." {
    while "rooted" "bubble-damage" 75 percent=#true
}
upgrade "inkCloud" jelly="tentacle" name="Ink Cloud" icon="🦑" text="When hit: bugs within 15 cm miss 50% of the time for 2 s." {
    when-hit cooldown=2 {
        ink radius=0.15 time=2 miss=0.5
    }
}
upgrade "venomSac" jelly="tentacle" name="Venom Sac" icon="🦂" text="Every 10th sting: the next lash stings every bug within reach and adds 3 Bleed stacks." {
    sting-count 10 {
        sweep bleed=3
    }
}
upgrade "coil" jelly="tentacle" name="Coil" icon="➰" text="A bug stung 4 times within 2 s is Stunned for 1 s." {
    pin-on-stings 4 within=2 seconds=1
}
upgrade "bellPulse" jelly="tentacle" name="Bell Pulse" icon="🔔" text="Every 2 s: the next lash reaches 3x as far." {
    every 2 {
        reach-flare 3
    }
}

// --- Poison: stacks, weakening, spreading Poison, healing from Poisoned kills (docs/jelly-types/types/poison.md).
// Numbers are starting values. Wither and Venom Strike say it with status-damage's per-stack (hits only, not Poison itself)
upgrade "wither" jelly="poison" name="Wither" icon="🥀" text="+10% damage to bugs per Poison stack on them. Elites and the Boss too." {
    status-damage "poisoned" more=0 per-stack=0.1 elites=#true
}
upgrade "lingeringDose" jelly="poison" name="Lingering Dose" icon="⏳" text="Poison stacks run for 10 s, not 5 s." {
    element-up "poison" poisonTime=2
}
upgrade "overdose" jelly="poison" name="Overdose" icon="💉" text="Poison stacks up to 10, not 5." {
    element-up "poison" poisonStacks=2
}
upgrade "splatter" jelly="poison" name="Splatter" icon="💦" text="The Poison blob's burst is 50% wider." {
    element-up "poison" width=1.5
}
upgrade "venomStrike" jelly="poison" name="Venom Strike" icon="🐍" text="The Poison blob's hit does +20% damage per Poison stack on the bug. Elites and the Boss too." {
    status-damage "poisoned" more=0 per-stack=0.2 by="poison" elites=#true
}
upgrade "wasteAway" jelly="poison" name="Waste Away" icon="🦴" text="Poisoned bugs lose 2% of their max Health a second. Elites too." {
    percent-dot "poisoned" share=0.02
}
upgrade "toxicCloud" jelly="poison" name="Toxic Cloud" icon="🌫️" text="When a Poisoned bug dies: a Poison cloud for 3 s Poisons bugs within 5 cm." {
    on-kill-of status="poisoned" {
        cloud radius=0.05 time=3
    }
}
upgrade "burstSac" jelly="poison" name="Burst Sac" icon="💣" text="When a Poisoned bug dies: passes its Poison stacks to bugs within 8 cm." {
    on-kill-of status="poisoned" {
        pass-stacks "poisoned" radius=0.08
    }
}
upgrade "leech" jelly="poison" name="Leech" icon="🩸" text="When a Poisoned bug dies: +1 Health." {
    on-kill-of status="poisoned" {
        heal 1 most=5
    }
}
upgrade "contagion" jelly="poison" name="Contagion" icon="🦠" text="Bugs touching a Poisoned bug get a Poison stack." {
    spread-on-touch "poisoned"
}
upgrade "poisonRain" jelly="poison" name="Poison Rain" icon="🌧️" text="Every 8 s: 4 Poison blobs hit bugs within 30 cm." {
    every 8 {
        blob count=4 range=0.3
    }
}
upgrade "splitBlob" jelly="poison" name="Split Blob" icon="🧫" text="On a hit: the Poison blob splits into 2 that fly on, each for 50% of the hit." {
    split-on-hit 2 dmg=0.5
}

// --- Glitter: chance, Luck, Crits, random effects and XP (docs/jelly-types/types/glitter.md). Numbers are starting values.
upgrade "prism" jelly="glitter" name="Prism" icon="🔺" text="On a hit: 3 shots from the splash hit the nearest bugs within 20 cm for 30% of the hit each." {
    echo-bubble from="splash" count=3 dmg=0.3
}
upgrade "rainbow" jelly="glitter" name="Rainbow" icon="🌈" text="Each Glitter bomb's splash Burns, Chills or Stuns bugs at random for 1.5 s." {
    random-status statuses="burning chilled stunned" time=1.5
}
upgrade "luckySparkle" jelly="glitter" name="Lucky Sparkle" icon="🍀" text="+15% Crit chance on splashes. Crits do 3x damage." {
    crit by="splash" chance=0.15 mult=3
}
upgrade "confettiPop" jelly="glitter" name="Confetti Pop" icon="🎊" text="On a kill by a splash: it splashes again for 50% of the hit." {
    on-kill-of by="splash" {
        splash dmg=0.5
    }
}
upgrade "midasTouch" jelly="glitter" name="Midas Touch" icon="👑" text="1 in 20 splash hits: the bug turns to gold, Stunned for 3 s, then bursts into 5 small Glitter bombs. Not Elites or the Boss." {
    gild chance=0.05 time=3 bombs=5
}
upgrade "discoBomb" jelly="glitter" name="Disco Bomb" icon="🕺" text="Every 4 s: the next bomb splashes 3x as wide." {
    every 4 {
        next-attack width=3
    }
}
upgrade "mirrorGlitter" jelly="glitter" name="Mirror Glitter" icon="🔆" text="A splash that reaches a wall goes off once more, off the wall." {
    splash-reflect
}
// kills=10: one splash killing 10 is rare in act 1, likelier with Hot Streak and Disco Bomb
upgrade "wish" jelly="glitter" name="Wish" icon="🌠" text="Once per act: a splash that kills at least 10 bugs gives a free level-up." {
    wish 10
}
upgrade "jackpot" jelly="glitter" name="Jackpot" icon="🎰" text="1 in 50 kills: a big XP droplet worth the rest of your Level." {
    crumb-on-kill drop="level" chance=0.02
}
// "until a splash kills fewer" said with stack-buff's time: each big splash adds 50% Attack size for 4 s, up to 3
upgrade "hotStreak" jelly="glitter" name="Hot Streak" icon="📈" text="When a splash kills at least 3 bugs: +75% Attack size for 5 s, up to +225%." {
    stack-buff "big-splash" "bubble-size" 75 percent=#true time=5 stacks=3
}
upgrade "partyPopper" jelly="glitter" name="Party Popper" icon="🎉" text="1 in 8 attacks: a bomb 2x as big does 3x damage." {
    nth-attack 8 random=#true {
        big dmg=3 size=2
    }
}
upgrade "starBurst" jelly="glitter" name="Star Burst" icon="🌟" text="When a splash hits at least 5 bugs: a shot at each hits for 50% of the hit." {
    splash-shots min=5 dmg=0.5
}
// --- Wind: movement, pushes, Dodge, jumps and landings (docs/jelly-types/types/wind.md). Numbers are starting values.
upgrade "cyclone" jelly="wind" name="Cyclone" icon="🌪️" text="Every 5 s: a whirlwind at the nearest bug within 30 cm pulls bugs in for 1.6 s." {
    every 5 {
        whirl radius=0.09 time=1.6 pull=0.12 range=0.3
    }
}
upgrade "bowling" jelly="wind" name="Bowling" icon="🎳" text="Bugs a Gust shoves hit every bug in their way for 100% of the hit. Not Elites or the Boss." {
    pushed-hits
}
upgrade "tailwind" jelly="wind" name="Tailwind" icon="🍃" text="On a hit: +30% Move speed for 2 s, up to +60%." {
    stack-buff "hit" "move-speed" 30 percent=#true time=2 stacks=2
}
upgrade "updraft" jelly="wind" name="Updraft" icon="🪁" text="On landing: shoves bugs within 12 cm 6 cm away." {
    landing-shockwave 0.12 dmg=0 push=0.06
}
upgrade "gale" jelly="wind" name="Gale" icon="💨" text="Gusts pierce every bug, doing 20% less damage after each." {
    element-up "wind" pierce=99 falloff=0.2
}
upgrade "slipstream" jelly="wind" name="Slipstream" icon="🏄" text="At full speed: +20% Dodge." {
    while "moving" "dodge" 20
}
upgrade "crosswind" jelly="wind" name="Crosswind" icon="🧭" text="Each Gust fires a second Gust 30° to the side." {
    element-up "wind" count=1 angle=30
}
upgrade "eyeOfTheStorm" jelly="wind" name="Eye of the Storm" icon="👁️" text="Every 2 s: a ring hits bugs within 10 cm for 0.9x Attack damage and shoves them 6 cm." {
    every 2 {
        ring 0.1 dmg=0.5 push=0.06
    }
}
upgrade "slamDunk" jelly="wind" name="Slam Dunk" icon="🏀" text="A bug a Gust shoves into furniture takes 3x the hit, not 1x." {
    element-up "wind" collision=3
}
upgrade "secondWind" jelly="wind" name="Second Wind" icon="🎐" text="Once per act: when hit at 30% Health or less, shoves bugs within 15 cm 10 cm away and +50% Move speed for 5 s." {
    when-hit once-per-act=#true low-health=0.3 {
        ring 0.15 dmg=0 push=0.1
        dash 0.5 time=5
    }
}
upgrade "jetStream" jelly="wind" name="Jet Stream" icon="🚀" text="Gusts fly 50% faster and 50% farther." {
    element-up "wind" speed=1.5 range=1.5
}
upgrade "glide" jelly="wind" name="Glide" icon="🪂" text="Hold jump in the air: fall 80% slower. Gusts blown while falling shove bugs 2x as far." {
    glide fall=0.2 push=2
}

// --- Normal: bubble physics (docs/jelly-types/types/normal.md). Numbers are starting values.
// Popcorn says it with the split-on-hit word Split Blob brought. Pop Chain, Rapid Pop and Bubble Trap act on
// what a bubble hits, the rest on how it flies (src/bubbles.js)
upgrade "doubleBubble" jelly="normal" name="Double Bubble" icon="⚪" text="+1 Attack that costs the others no damage." {
    stat bubbles 1 no-penalty=#true
}
upgrade "popcorn" jelly="normal" name="Popcorn" icon="🍿" text="On a hit: the bubble splits into 3 that fly on, each for 35% of the hit." {
    split-on-hit 3 dmg=0.35 angle=60
}
upgrade "bubbleTrap" jelly="normal" name="Bubble Trap" icon="🕸️" text="1 in 2 hits: the bug is Trapped for 1.5 s. Not Elites or the Boss." {
    trap-on-hit chance=0.5 time=1.5
}
upgrade "bigBubble" jelly="normal" name="Big Bubble" icon="🔵" text="+100% Attack size." {
    stat bubble-size 100 percent=#true
}
upgrade "homing" jelly="normal" name="Homing" icon="🎯" text="Bubbles curve toward the nearest bug within 10 cm." {
    homing 5
}
upgrade "popChain" jelly="normal" name="Pop Chain" icon="⛓️" text="On a hit: pops every bubble within 4 cm, each hitting bugs for 60% of its hit." {
    pop-chain 0.6
}
upgrade "wobble" jelly="normal" name="Wobble" icon="〰️" text="Bubbles zigzag 2 cm to each side, brushing more bugs." {
    wobble 0.02
}
upgrade "ricochet" jelly="normal" name="Ricochet" icon="↩️" text="Bubbles ricochet off up to 3 walls." {
    rebound walls-only=#true times=3
}
upgrade "bubbleChain" jelly="normal" name="Bubble Chain" icon="🔗" text="On a kill: the bubble flies on to the nearest bug within 20 cm for 100% of the hit, again after each kill." {
    echo-bubble on="kill"
}
upgrade "rapidPop" jelly="normal" name="Rapid Pop" icon="🥊" text="+20% damage per hit in a row on one bug, up to +200%." {
    focus-ramp 0.2 most=2
}
upgrade "bigFinish" jelly="normal" name="Big Finish" icon="🎆" text="A bubble that reaches full Range without a hit pops in a splash 2x as wide." {
    range-pop 2
}
upgrade "orbit" jelly="normal" name="Orbit" icon="🪐" text="A bubble that reaches full Range without a hit circles you once, hitting bugs it touches." {
    orbit-misses
}

// --- Lightning: chains and charge-ups (docs/jelly-types/types/lightning.md). Numbers are starting values.
// The shots' arcs hit 3 more bugs for 41% each and Stun them 0.5 s (content/jellies.kdl).
upgrade "overcharge" jelly="lightning" name="Overcharge" icon="🔋" text="Every 5th shot: a bolt 1.5x as big, its arcs do 2x damage and jump 2x as far." {
    nth-attack 5 {
        bolt dmg=2 reach=2
    }
}
upgrade "conductor" jelly="lightning" name="Conductor" icon="🔌" text="Arcs jump to 3 more bugs and can return to bugs already hit." {
    element-up "lightning" revisit=1 chain=3
}
upgrade "staticSkin" jelly="lightning" name="Static Skin" icon="🦔" text="Bugs touching you are zapped for 1.1x Attack damage and Stunned for 1 s. 2 s cooldown on each bug. Elites and the Boss are not Stunned." {
    touch-zap dmg=0.6 stun=1 each=2
}
upgrade "stormCell" jelly="lightning" name="Storm Cell" icon="⛈️" text="After 2 s standing still: your next shot also hits every bug within 20 cm of where it lands for 200% of the hit." {
    charged-shot "rooted" 2 strike=0.2
}
upgrade "thunderclap" jelly="lightning" name="Thunderclap" icon="🥁" text="Stunned bugs take 150% more damage." {
    status-damage "stunned" more=1.5
}
upgrade "ballLightning" jelly="lightning" name="Ball Lightning" icon="🟡" text="Every 6 s: a slow ball of lightning zaps each bug within 2.5 cm of it for 2.7x Attack damage." {
    every 6 {
        orb
    }
}
upgrade "chainReaction" jelly="lightning" name="Chain Reaction" icon="💫" text="When a Stunned bug dies: bolts zap the 2 nearest bugs within 16 cm for 1.8x Attack damage." {
    on-kill-of status="stunned" {
        zap 2 range=0.16 dmg=1 look="bolt"
    }
}
upgrade "lightningRod" jelly="lightning" name="Lightning Rod" icon="🗼" text="Arcs jump to Stunned bugs first. Stunned bugs take 60% more damage from Lightning." {
    element-up "lightning" stunFirst=1
    status-damage "stunned" more=0.6 by="lightning"
}
upgrade "overload" jelly="lightning" name="Overload" icon="🌩️" text="Every 6 s: a bolt zaps the toughest bug within 45 cm for 9x Attack damage." {
    every 6 {
        zap 1 target="toughest" dmg=5 look="bolt"
    }
}
upgrade "staticCharge" jelly="lightning" name="Static Charge" icon="🏃" text="After 3 s of moving: your next shot arcs to 6 more bugs." {
    charged-shot "moving" 3 chain=6
}
upgrade "surge" jelly="lightning" name="Surge" icon="🌊" text="On an arc: +4% Fire rate for 3 s, up to +80%." {
    stack-buff "arc" "fire-rate" 4 percent=#true time=3 stacks=20
}
upgrade "grounded" jelly="lightning" name="Grounded" icon="🌍" text="Arcs do 3x damage to Elites and the Boss." {
    element-up "lightning" eliteBolt=3
}

// --- Summoner: the little jellies (docs/jelly-types/types/summoner.md). Numbers are starting values. Ring and zap
// dmg= are x your power (1.8 x Attack damage): 1.1 is 2x Attack damage, 1.67 3x, 0.28 half.
// The six Moulds give the little jellies an Element; with two or more, each one set down takes the next in turn.
upgrade "cinderMould" jelly="summoner" name="Cinder Mould" icon="🔥" text="Little jellies fire Fire shots. When a little jelly is gone: a ring hits bugs within 10 cm for 2x Attack damage. Little jellies stay 8 s longer." {
    turret-up more-time=8
    turret-element "fire"
    turret-on "end" {
        ring 0.1 dmg=1.1 color="#ff8a3d"
    }
}
upgrade "frostMould" jelly="summoner" name="Frost Mould" icon="❄️" text="Little jellies fire Ice shards. Every 1 s: Chills bugs within 12 cm of a little jelly for 1.2 s. Little jellies stay 8 s longer." {
    turret-up more-time=8
    turret-element "ice"
    turret-on "every" every=1 {
        ring 0.12 dmg=0 chill=1.2 color="#9cc4ff" show=0.3
    }
}
upgrade "teslaMould" jelly="summoner" name="Tesla Mould" icon="⚡" text="Little jellies fire Lightning shots. Every 2 s: each little jelly zaps the 2 nearest bugs within 15 cm for 0.5x Attack damage. Little jellies stay 8 s longer." {
    turret-up more-time=8
    turret-element "lightning"
    turret-on "every" every=2 {
        zap 2 range=0.15 dmg=0.28 look="bolt"
    }
}
upgrade "sporeMould" jelly="summoner" name="Spore Mould" icon="🍄" text="Little jellies fire Poison blobs. When a little jelly is gone: a Poison cloud for 4 s Poisons bugs within 10 cm. Little jellies stay 8 s longer." {
    turret-up more-time=8
    turret-element "poison"
    turret-on "end" {
        cloud radius=0.1 time=4
    }
}
upgrade "galeMould" jelly="summoner" name="Gale Mould" icon="🌬️" text="Little jellies fire Gusts. When a little jelly is set down: shoves bugs within 12 cm 8 cm away. Little jellies stay 8 s longer." {
    turret-up more-time=8
    turret-element "wind"
