// The bosses. Each one is its Health, how hard it bumps into you, and a block of
// numbers per attack; src/vacuum.js, src/clog.js and src/pothos.js read them from here. The dev
// balance editor (pause → Dev → ⚖️ Tuner) edits these live: a boss already fighting
// uses a skill's new numbers from its next attack, and a new Health the next time
// it powers on.
//
//   hp       Health              contact  damage when it bumps into you
//   windup   warning time (s)    time     how long the attack runs (s)
//   dmg      Health per hit (suction and flood pour it on: per second)
//   speed    m/s                 slow     seconds you stay tangled/slowed
//   at       the Health fraction that trips it (enrage, the Clog's swarm)

boss "vacuum" name="The Vacuum" hp=1400 contact=2 {
    chase   time=2.6 speed=0.3
    charge  windup=1.0 time=1.3 speed=1.05 dmg=4
    suction time=5 pull=0.36 dmg=2
    brushes time=1.4 dmg=3 reach=0.1
    dump    time=1.1 roaches=3
    // (one more roach when angry: that's the attack's rule, not a number)
    spin    time=3 every=0.18 speed=0.9 dmg=3
    flies   windup=1.0 count=4 shield=30 max=2
    enrage  at=0.5 pace=2
}

boss "clog" name="The Clog" hp=1500 contact=3 {
    // between attacks it hops at you: `hop` m a hop (less if you're closer), `air` s in the air,
    // `height` m up, a hop every `every` s (`angryEvery` angry); bumping into it tangles you `tangle` s
    chase   time=2.4 angryTime=1.5 speed=0.2 angrySpeed=0.3 hop=0.16 air=0.32 height=0.05 every=0.6 angryEvery=0.4 tangle=0.8
    // three leaps at you: `windup` s crouching (70% after the first), `air` s flying `height` m up;
    // its landing spot follows you until `lock` s before it lands, a Blast `radius` m round; the
    // last slam rolls a ring wave out to `ring` m at `ringSpeed` m/s, `ringH` m high (`ringDmg`)
    pinball windup=0.55 air=0.6 height=0.22 lock=0.3 count=3 radius=0.13 dmg=3 knock=0.9 ring=0.55 ringSpeed=0.5 ringH=0.025 ringDmg=2
    // hair curtains across the tub in 5 lanes `width` m wide, `height` m tall (no jumping them):
    // every other lane, then the rest, `waves` times; `windup` s for the first, `next` s after
    comb    windup=0.8 next=0.6 waves=3 width=0.1 height=0.12 dmg=3 slow=1
    lash    windup=0.8 angryWindup=0.5 dmg=3 slow=2
    snare   windup=0.9 dmg=3 slow=1.5
    roll    windup=0.75 time=1.1 speed=1.3 angrySpeed=2 dmg=4
    flood   time=8 pull=0.6 dmg=6
    shed    time=1.0 count=3
    // (one more tangle when angry, same rule as the Vacuum's dump)
    spray   time=4 every=0.1 speed=0.75 dmg=2
    swarm   at=0.7 count=4 shield=30
    enrage  at=0.65
}

// act 3's, the houseplant on the pillows: only its heart takes damage. Its attacks: src/pothos.js
// ATTACKS. Aerial roots: the root itself (falling, creeping, holding on) is content/enemies.kdl's "root"
//   count  how many drop (one right where you are, the rest round you)   spread  how far round (m)
//   rest   the pause before its next attack (s)
// Cuttings: `near` m from you, `count` of them (`angryCount` when it's angry); each Cutting and the
// Sap sprout it grows into are content/enemies.kdl's "cutting" and "sprout"
// Vine Whips: it aims `lead` s ahead of where you're swimming (that lead is its one exception to
// never leading); the Warning shows for `windup` s (a Boss attack's usual length, as long as the
// Clog's lash), then the vine lashes along a curved lane `width` wide and `height` tall (jump it) out
// to `reach` m from the pot; `knock` is how hard a hit throws you aside and `launch` how far up;
// then its leaves part for `open` s: the moment to hit its heart. `count` vines at once (`angryCount`
// angry), each on its own lane: the first aimed, the others swung `swing` radians round the pot to
// either side of it (keep it wide enough to leave room between lanes to slip through)
// The sweep: a vine winds up at one end of a wedge `arc` degrees wide in front of the plant while
// its Warning fills (`windup` s), then sweeps across it in `swing` s, `height` tall (jump it), out to
// `reach` m from the pot (from 0.4 of that: closer in, the guarding vines take over)
// The guarding vines: while you're within `radius` m of its heart, a vine snaps at where you are,
// `first` s after you come close and every `every` s while you stay: a short straight lane (`over` m
// past you) with a quick Warning (`windup` s), `width` wide and `height` tall; a hit is `dmg` and
// knocks you `knock` away from the heart. They hold still while its leaves are parted after a whip
// The swarm: once, the first time its Health drops below `at`, `count` dragonflies (content/enemies.kdl
// "dragonfly") come out of the plant and its leaves close over its heart until they're dead or
// `shield` s have passed
// bump: touching the pot hurts (contact) and pushes you off it at `push` m/s, at most every `every` s
// rise: how fast it grows up out of the pillows as the fight starts (the whole rise per second)
boss "pothos" name="The Pothos" hp=1500 contact=2 {
    whip    time=1.0 windup=0.8 lash=0.15 lead=0.5 width=0.04 height=0.04 reach=1.1 dmg=4 knock=0.8 launch=0.15 swing=0.6 open=1.5 count=2 angryCount=3 rest=0.95 angryRest=0.35
    sweep   time=1.4 windup=0.8 swing=0.45 arc=105 reach=0.7 height=0.035 dmg=3 knock=0.6 rest=0.95 angryRest=0.35
    guard   radius=0.28 first=0.25 every=0.55 windup=0.45 lash=0.12 over=0.08 reach=0.45 width=0.035 height=0.04 dmg=3 knock=0.7
    cutting time=1.0 count=1 angryCount=2 near=0.16 rest=0.95 angryRest=0.35
    roots   time=1.2 count=3 spread=0.18 rest=0.95 angryRest=0.35
    swarm   time=1.0 at=0.7 count=4 shield=30 rest=0.95 angryRest=0.35
    enrage  at=0.45
    bump    push=0.6 every=0.3
    rise    rate=0.55
}

// act 4's, the DJ booth on the concert stage: src/encore.js. Its attacks all land on its song's beat
// (src/encore-floor.js, encore-laser.js, encore-pulse.js, encore-disco.js, encore-contact.js, their
// numbers in content/look.css --encore-*). Beetles: at beat `at` (bar 8) and every `every` beats
// after (16 bars), it calls stag beetles (content/enemies.kdl "beetle") up to `count` on the floor at once;
// its force field holds while any live, or for `timeout` s at most
boss "encore" name="The Encore" hp=3000 contact=0 {
    beetles at=32 every=64 count=2 timeout=90
    // at `at` of its Health its booth shorts out (a cut scene), then its disco ball stays down
    meltdown at=0.5
}
