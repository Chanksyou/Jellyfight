// The elites: the things on the furniture that came alive (src/elites.js). Health, how close
// you have to get to wake one (aggro, m), and each attack's damage and headline counts. icon= is
// its picture in the Treasure book: every book entry has its own.
// Under half health the Soap Dispenser, the Wall Clock and the Cream Whipper are angry
// (angry= is that fraction of Health). Radii, telegraph shapes and phase timings stay in
// the code: they are the attacks' choreography, drawn by the telegraphs themselves (the
// Alligator, the newest, keeps its radii, timings and speeds here too: m, s, m/s).
// pace is every elite's tempo: rest between attacks runs down recover× as fast, and each
// attack plays tempo× as fast.

pace recover=1 tempo=1.4

elite "controller" name="The Controller" icon="🎮" hp=250 aggro=1.1 {
    barrage dmg=3 windup=1.4 gap=0.35 radius=0.075 height=0.06 spread=0.19 rest=1.6   // gap: tempo s between symbols going off, in their buttons' order
    rumble dmg=3
}

elite "mug" name="The Mug" icon="☕" hp=250 aggro=0.9 {
    coffee dmg=3 lobs=5 drain=3
    spill dmg=3 puddles=7 width=0.08 height=0.06 carry=0.4 push=0.7   // a lane wave (m); caught, washed along at push= m/s for carry= s
}

elite "kettle" name="The Kettle" icon="♨️" hp=275 aggro=1.4 {
    ball dmg=3 shots=3 every=0.4 lead=1 gusts=3 gap=0.15 charge=1.4 flight=0.6 radius=0.06   // charge is in tempo time (1.4 is 1 s at tempo 1.4); every, flight and gap are real s; lead: each ball aims where you'll be as it lands (1: all the way, 0: where you are)
    boil dmg=3 reach=0.5 safe=0.08 away=0.2 flight=0.6 fill=1.6   // lid lands at least away= m from you, a safe circle of safe= m round it; steam over reach= m round the Kettle once fill= tempo s are up
}

elite "soap" name="The Soap Dispenser" icon="🧼" hp=400 aggro=1.2 angry=0.75 {
    trap dmg=4 count=1 angryCount=2 radius=0.04 hp=20 speed=0.15 life=6 hold=1.4 carry=0.1   // big bubbles drifting after you at speed= m/s; hp= to pop; caught, held hold= s, carried carry= m/s toward it
    ring dmg=3 rings=3 angryRings=5
}

elite "clock" name="The Wall Clock" icon="🕰️" hp=400 aggro=0.75 angry=0.65 {
    sweep dmg=4
    wreath dmg=4
    hour dmg=4 rounds=3 warn=1.0   // Telling the time: rounds= times its hands point at the bench, a wedge under each, striking after warn= tempo s
}

elite "whipper" name="The Cream Whipper" icon="🍦" hp=400 aggro=1.25 angry=0.65 {
    balloon dmg=4 count=2 angryCount=3 fuse=4 muffle=5
    piping dmg=3 slow=2 pipe=3.5 angryPipe=5 stay=4 angryStay=6 wake=0.8 height=0.04 sag=0.6   // s are real s: it pipes along your path for pipe= s, wake= s behind you; the bead (height= m) stays stay= s, then sags sag= s
}

// act 3: the plush on the pillows at the head of the bed. It sleeps until you're on the bed
// (stage3.js `wake`), then within aggro= of it.
//   volley: its mouth opens for windup= s while count= Warnings fill in a fan round you, spread=
//           apart; then frost balls are flung there in a high arc (arc= m over the line, flight= s),
//           one after another from one end of the fan, stagger= s apart,
//           and burst as Blasts of radius=,
//           slowing you by slow= for slowTime= s
//   tail:   it turns its back (turn= s) and slams its tail slams= to maxSlams= times, a random
//           gap= (gapMin= to gapMax= s) before each; each sends a ring wall height= tall, band=
//           thick, out at speed= m/s to reach= m: jump it, or it hits and shoves you on (knock=)
//   pounce: it crouches for windup= s while a Warning of radius= fills where you are, following you
//           until lock= of the crouch; then it leaps there (leap= m up, air= s) and lands as a Blast of
//           radius= round itself (knock= knocks you back), and stays there till you leave the bed
elite "croc" name="The Alligator" icon="🐊" hp=800 aggro=1.8 angry=0.65 {
    volley dmg=3 count=3 angryCount=5 spread=0.16 radius=0.09 size=0.016 windup=0.8 angryWindup=0.6 flight=0.45 stagger=0.15 arc=0.25 slow=0.5 slowTime=1.5 rest=1.0 angryRest=0.7
    tail dmg=3 slams=3 maxSlams=5 angrySlams=4 angryMaxSlams=6 gapMin=0.35 gapMax=0.9 turn=0.5 height=0.03 band=0.07 speed=0.5 reach=0.9 knock=0.45 rest=1.0 angryRest=0.7
    pounce dmg=4 radius=0.2 lock=0.5 windup=1.0 angryWindup=0.75 leap=0.2 air=0.55 knock=0.9 rest=1.1 angryRest=0.8
}

// act 3: the red plush bull on the changing table (the dresser by the north wall). It sleeps
// until you're on the table top (stage3.js `wake`), then within aggro= of it.
//   rush:   its horns swell (horns= times their size) for windup= s while a lane Warning width= wide
//           and height= tall (too tall to jump) fills from it through you to the table's edge; then
//           it charges down it at speed= m/s (real s), knocking you on (knock=) if it meets you, skids
//           to a stop at the edge and stands dizzy for dizzy= s (hit it), then walks home
//   spiral: a Warning circle of warnRadius= fills round it for warn= s; then it spins, firing arms=
//           opposite Shots every= s for time= s while it turns turn= degrees a second, each flying
//           out at speed= m/s for reach= m (size=: its radius, m): the arms alternate floor level
//           (jump them) and jump height (stay down)
//   minis:  two little bulls appear side= m to your left and right, each with a lane Warning
//           through where you are (width= wide, height= tall, reach= long) filling for warn= s;
//           then they charge along it at speed= m/s and burst on you (knock=), on each other, or
//           at the lane's end or the table's edge
elite "bull" name="The Bull" icon="🐂" hp=800 aggro=1.0 angry=0.65 {
    rush dmg=4 width=0.14 height=0.22 windup=1.2 angryWindup=0.9 horns=2 angryHorns=2.5 speed=1.0 angrySpeed=1.3 knock=1.6 dizzy=1.2 rest=1.0 angryRest=0.7
    spiral dmg=2 arms=2 angryArms=3 warn=0.6 warnRadius=0.16 time=2.5 every=0.08 turn=200 angryTurn=260 speed=0.35 reach=0.7 size=0.009 rest=1.0 angryRest=0.7
    minis dmg=3 side=0.15 warn=0.7 speed=0.6 angrySpeed=0.8 reach=0.4 width=0.07 height=0.09 knock=1.0 rest=1.0 angryRest=0.7
}

// act 3: the Latticework Coffer, the mimic box on the vanity desk in the north-west corner. It
// sleeps (a plain box) until you're on the desk top (stage3.js `wake`), then within aggro= of it.
//   accordion: strikes= strikes in a row. Each aims where you are (no further than range= m from
//              it) and a Warning of radius= fills there for unfold= s while the lid shoots out on its
//              bellows, hovering hover= m over the spot; the Warning follows you until track= of the
//              strike, then locks, and the lid slams down there as a Blast
//   tongue:    its mouth opens for open= s, then the tongue shoots to you in shoot= s and latches on:
//              it can't miss. For hold= s it pulls you toward its mouth at pull= m/s (base swim speed
//              is 0.42 m/s: config.js walkSpeed, so it takes over 143% move speed to get away, 167% angry);
//              brought within bite= m of its middle its jaws slam shut on you (dmg=), it chews chews= times
//              (chew= s each) and spits you back out (knock= knocks you away)
//              and it lets go; else it lets go at the end
//   jewels:    count= amber jewels shoot up out of sight off its lid while count= Warnings of radius=
//              fill on random spots of the desk top (spread= m apart at least) for rain= s; then the
//              jewels fall from up= m onto them in drop= s and burst as Blasts
// (its times were authored for tempo=1.2; the shared pace above scales these attacks too)
elite "coffer" name="The Latticework Coffer" icon="🧰" hp=800 aggro=1.2 angry=0.65 {
    accordion dmg=3 strikes=5 range=0.8 radius=0.06 unfold=0.6 track=0.45 angryUnfold=0.48 hover=0.05 rest=1.0 angryRest=0.7
    tongue dmg=6 open=0.4 shoot=0.15 hold=4.8 pull=0.6 angryPull=0.7 bite=0.14 chews=3 chew=0.22 knock=1.0 rest=1.0 angryRest=0.7
    jewels dmg=3 count=10 angryCount=14 radius=0.1 spread=0.17 rain=2.4 drop=0.25 up=0.9 rest=1.0 angryRest=0.7
}

// act 4: the Singing Bowl, on its cushion on the lounge chair in the living room at dawn. It sleeps
// until you're on the chair (stage4.js ELITES4 `wake`), then within aggro= of it. It keeps the song's
// time: windup= and echo= are beats of the song (128 BPM: a beat is 0.47 s), not
// the pace's tempo; rest= is s, as for every elite.
// snap= (all three Elites, on every attack that times to the song): beats a hit rounds up to, default 4
// (a bar); act 4 uses 2, so a hit lands on the next half bar at least windup= beats away.
//   ring:  the striker lifts while a Warning of radius= (a disc and the ring wall over it) fills,
//          then strikes the rim on the first snap line at least windup= beats away, and a ring wall
//          height= tall, band= thick rolls out at speed= m/s to reach= m: jump it. Then echo= beats
//          later it rolls back in to the bowl, the same wall (jump it again). rings= of them,
//          one a bar; angry, angryRings= of them two a bar, every second one at angrySpeed=
//   hum:   the striker runs round the rim and its song swells while a Warning fills the whole seat
//          (its cushion, `seat` in stage4.js ELITES4) except a white safe circle, safe= m from the bowl's middle;
//          on the first snap line at least windup= beats away the sound hits everything on the seat
//          outside that circle (the jelly's body counting), up to height= m over it (a jump doesn't clear it), and shoves you a little (knock=):
//          swim in close, where the rings' echo catches you
elite "bowl" name="The Singing Bowl" icon="🥣" hp=800 aggro=1.2 angry=0.65 {
    ring dmg=5 rings=5 angryRings=7 snap=1 windup=1 warn=0.09 height=0.05 band=0.04 speed=0.5 angrySpeed=0.7 reach=0.7 echo=3 rest=0.6 angryRest=0.4
    hum dmg=3 snap=2 windup=3 safe=0.12 height=0.35 knock=0.5 rest=0.6 angryRest=0.4
}

// act 4: the Mushroom Pillow, on the sofa seat in the living room at dawn. It sleeps until you're on
// the sofa (stage4.js ELITES4 `wake`), then within aggro= of it. Like the Singing Bowl it keeps the
// song's time: windup=, drift=, windup= and air= are beats of the song (a beat is 0.47 s); rest= is s.
//   spores: its cap breathes in for at least windup= beats, then on a beat it puffs spots= spores that
//           drift over the seat for drift= beats (the first onto where you are, the rest within near= m
//           of you, spread= m apart) and settle as marked spots radius= m round; they flash for one
//           beat, then burst on the bar as columns: dmg= once, anywhere in the column (as tall as
//           look.css --pillow-column, over a full jump, so a jump doesn't clear one). Angry, angrySpots= of
//           them settling in angryDrift= beats
//   fairy:  it breathes in for at least windup= beats while a circle follows you, then on a beat caps=
//           caps sprout in a ring ring= m round where you stand (each radius= m), their Warnings filling
//           for grow= beats, flashing one beat, then bursting on a snap= line as columns (as tall as look.css
//           --pillow-column): dmg= once, anywhere in a column, and a cap touched goes off at once. Hold
//           still in the middle; run and you cross a column. Angry: after the first ring bursts a
//           second sprouts flee= m on, the way you were moving (else away from it)
elite "pillow" name="The Mushroom Pillow" icon="🍄" hp=800 aggro=1.5 angry=0.65 {
    spores dmg=5 spots=6 angrySpots=9 snap=2 windup=1 drift=1 angryDrift=0.5 radius=0.06 near=0.45 spread=0.13 rest=0.6 angryRest=0.4
    fairy dmg=5 caps=8 ring=0.12 radius=0.04 snap=1 windup=1 grow=1 flee=0.34 rest=0.6 angryRest=0.4
}

// act 4: the Headphones, up on their ear cups on the kitchen counter by the stove in the living room at dawn. They
// sleep until you're on the counter (stage4.js ELITES4 `wake`), then within aggro= of them. Like the
// Singing Bowl they keep the song's time: windup=, every= and lock= are beats of the song; rest= is s.
// The counter is 1.3 m long and 0.65 m deep and ends at a drop: falling off is the punishment, and the vent by the stove brings you back.
//   shove: the cups take turns, waves= of them every= beats apart from the first snap line at least
//          windup= beats away. Each one's Warning (a white strip width= m wide from the cup through you
//          to the table's edge, and the lane height= m tall over it) follows you until lock= beats
//          before; then a white sound wave rolls down it at speed= m/s. It doesn't hurt: a jelly under
//          its top as it passes is shoved push= m along it (over carry= s). Jump it to stay put.
//          Angry, the shove has no extras; its wave joins Stereo instead
//   stereo: a dividing line down the counter through the Headphones; each side is a half of the ground. The cups
//          take turns, bursts= of them every= beats apart, the first on the half you stand on and the first snap
//          line at least windup= beats away (the first half's Warning fills until then, then each fills for the
//          every= beats before its burst). A cup lights up and marks its half (a floor square and the slab over
//          it, height= m tall: a jump doesn't clear it, in the cup's own colour) filling to the beat; then
//          that half bursts for dmg=: cross to the other half on the beat. Which half you're on is where your
//          middle is. Angry, angryBursts= of them, and lead= beats after each burst but the last the cup that
//          just burst sends a shove wave (the shove's width, height, speed and push) through you across the
//          line; its Warning locks lock= beats before: jump it or sidestep it, or be shoved deeper into the half
//          about to burst
elite "headphones" name="The Headphones" icon="🎶" hp=800 aggro=1.5 angry=0.65 {
    shove waves=6 every=1 snap=1 windup=1 lock=0.5 width=0.2 height=0.1 speed=1.6 push=0.3 carry=0.3 rest=0.6 angryRest=0.4
    stereo dmg=5 bursts=6 angryBursts=8 every=1 snap=1 windup=1 height=0.5 lead=1 lock=0.5 rest=0.6 angryRest=0.3
}
