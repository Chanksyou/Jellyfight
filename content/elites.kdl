// The elites: the things on the furniture that came alive (src/elites.js). Health, how close
// you have to get to wake one (aggro, m), and each attack's damage and headline counts.
// Under half health the Soap Dispenser, the Wall Clock and the Cream Whipper are angry
// (angry= is that fraction of Health). Radii, telegraph shapes and phase timings stay in
// the code: they are the attacks' choreography, drawn by the telegraphs themselves.
// pace is every elite's tempo: rest between attacks runs down recover× as fast, and each
// attack plays tempo× as fast.

pace recover=1.4 tempo=1.15

elite "controller" name="The Controller" hp=195 aggro=0.7 {
    barrage dmg=2
    rumble dmg=3
}

elite "mug" name="The Mug" hp=220 aggro=0.8 {
    coffee dmg=2 lobs=2 drain=1.5
    spill puddles=4
}

elite "kettle" name="The Kettle" hp=275 aggro=0.6 {
    steam dmg=2
    boil dmg=2 drops=4
}

elite "soap" name="The Soap Dispenser" hp=310 aggro=0.7 angry=0.5 {
    squirt dmg=2 count=3 angryCount=4
    ring dmg=2 rings=1 angryRings=2
}

elite "clock" name="The Wall Clock" hp=390 aggro=0.55 angry=0.5 {
    sweep dmg=3
    wreath dmg=2
    hour dmg=2 chimes=3
}

elite "whipper" name="The Cream Whipper" hp=340 aggro=0.75 angry=0.5 {
    balloon dmg=2 count=1 angryCount=2 fuse=3 muffle=5
    cream dmg=2 slow=1.5
}
