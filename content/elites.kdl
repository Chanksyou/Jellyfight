// The elites: the things on the furniture that came alive (src/elites.js). Health, how close
// you have to get to wake one (aggro, m), and each attack's damage and headline counts.
// Under half health the Soap Dispenser, the Wall Clock and the Cream Whipper are angry
// (angry= is that fraction of Health). Radii, telegraph shapes and phase timings stay in
// the code: they are the attacks' choreography, drawn by the telegraphs themselves (the
// Alligator, the newest, keeps its radii, timings and speeds here too: m, s, m/s).
// pace is every elite's tempo: rest between attacks runs down recover× as fast, and each
// attack plays tempo× as fast.

pace recover=1.2 tempo=1.2

elite "controller" name="The Controller" hp=250 aggro=0.9 {
    barrage dmg=3
    rumble dmg=3
}

elite "mug" name="The Mug" hp=250 aggro=0.8 {
    coffee dmg=3 lobs=3 drain=1.5
    spill puddles=6
}

elite "kettle" name="The Kettle" hp=275 aggro=0.8 {
    steam dmg=3
    boil dmg=3 drops=6
}

elite "soap" name="The Soap Dispenser" hp=500 aggro=0.8 angry=0.75 {
    squirt dmg=4 count=6 angryCount=6
    ring dmg=3 rings=2 angryRings=3
}

elite "clock" name="The Wall Clock" hp=450 aggro=0.75 angry=0.65 {
    sweep dmg=4
    wreath dmg=4
    hour dmg=4 chimes=6
}

elite "whipper" name="The Cream Whipper" hp=450 aggro=0.75 angry=0.65 {
    balloon dmg=4 count=2 angryCount=3 fuse=4 muffle=5
    cream dmg=3 slow=2
}

// act 3: the plush on the pillows at the head of the bed. It sleeps until you're on the bed
// (stage3.js `wake`), then within aggro= of it.
//   volley: its mouth opens for windup= s while count= Warnings fill in a fan round you, spread=
//           apart; then frost balls are flung there in a high arc (arc= m over the line, flight= s)
//           and burst as Blasts of radius=,
//           slowing you by slow= for slowTime= s
//   tail:   it turns its back (turn= s) and slams its tail slams= to maxSlams= times, a random
//           gap= (gapMin= to gapMax= s) before each; each sends a ring wall height= tall, band=
//           thick, out at speed= m/s to reach= m: jump it, or it hits and shoves you on (knock=)
//   pounce: it crouches for windup= s while a Warning of radius= fills under it, leaps leap= m
//           up for air= s and lands as a Blast of radius= round itself (knock= knocks you back)
elite "croc" name="The Alligator" hp=500 aggro=1.8 angry=0.65 {
    volley dmg=3 count=3 angryCount=5 spread=0.16 radius=0.09 size=0.016 windup=0.8 angryWindup=0.6 flight=0.45 arc=0.25 slow=0.5 slowTime=1.5 rest=1.0 angryRest=0.7
    tail dmg=3 slams=3 maxSlams=5 angrySlams=4 angryMaxSlams=6 gapMin=0.35 gapMax=0.9 turn=0.5 height=0.03 band=0.07 speed=0.5 reach=0.9 knock=0.45 rest=1.0 angryRest=0.7
    pounce dmg=4 radius=0.32 windup=1.0 angryWindup=0.75 leap=0.2 air=0.55 knock=0.9 rest=1.1 angryRest=0.8
}

// act 3: the red plush bull on the changing table (the dresser by the north wall). It sleeps
// until you're on the table top (stage3.js `wake`), then within aggro= of it.
//   rush:   its horns swell (horns= times their size) for windup= s while a big Warning of radius=
//           fills round it; then a Blast round itself (knock= knocks you away): too big to jump,
//           get off the table or take it
//   spiral: a Warning circle of warnRadius= fills round it for warn= s; then it spins, firing arms=
//           opposite Shots every= s for time= s while it turns turn= degrees a second, each flying
//           out at speed= m/s for reach= m (size=: its radius, m): the arms alternate floor level
//           (jump them) and jump height (stay down)
//   minis:  two little bulls appear side= m to your left and right, each with a lane Warning
//           through where you are (width= wide, height= tall, reach= long) filling for warn= s;
//           then they charge along it at speed= m/s and burst on you (knock=), on each other, or
//           at the lane's end or the table's edge
elite "bull" name="The Bull" hp=500 aggro=1.0 angry=0.65 {
    rush dmg=4 radius=0.4 windup=1.2 angryWindup=0.9 horns=2 angryHorns=2.5 knock=1.6 rest=1.0 angryRest=0.7
    spiral dmg=2 arms=2 angryArms=3 warn=0.6 warnRadius=0.16 time=2.5 every=0.08 turn=200 angryTurn=260 speed=0.35 reach=0.7 size=0.009 rest=1.0 angryRest=0.7
    minis dmg=3 side=0.15 warn=0.7 speed=0.6 angrySpeed=0.8 reach=0.4 width=0.07 height=0.09 knock=1.0 rest=1.0 angryRest=0.7
}

// act 3: the Latticework Coffer, the mimic box on the vanity desk in the north-west corner. It
// sleeps (a plain box) until you're on the desk top (stage3.js `wake`), then within aggro= of it.
//   accordion: strikes= strikes in a row. Each locks where you are (no further than range= m from
//              it) and a Warning of radius= fills there for unfold= s while the lid shoots out on its
//              bellows, hovering hover= m over the spot; then the lid slams down there as a Blast
//   tongue:    its mouth opens for open= s, then the tongue shoots to you in shoot= s and latches on:
//              it can't miss. For hold= s it pulls you toward its mouth at pull= m/s (base swim speed
//              is 0.42 m/s: config.js walkSpeed, so it takes over 143% move speed to get away, 167% angry);
//              brought within bite= m of its middle you're bitten (dmg=, knock= knocks you back out)
//              and it lets go; else it lets go at the end
//   jewels:    count= amber jewels shoot up out of sight off its lid while count= Warnings of radius=
//              fill on random spots of the desk top (spread= m apart at least) for rain= s; then the
//              jewels fall from up= m onto them in drop= s and burst as Blasts
// (its times are written 1.2x long: pace tempo 1.2 plays every elite faster, so they play as the owner's 0.5 s unfold, 4 s leash and 2 s rain)
elite "coffer" name="The Latticework Coffer" hp=500 aggro=1.0 angry=0.65 {
    accordion dmg=3 strikes=5 range=0.6 radius=0.06 unfold=0.6 angryUnfold=0.48 hover=0.05 rest=1.0 angryRest=0.7
    tongue dmg=6 open=0.4 shoot=0.15 hold=4.8 pull=0.6 angryPull=0.7 bite=0.14 knock=1.0 rest=1.0 angryRest=0.7
    jewels dmg=3 count=10 angryCount=14 radius=0.05 spread=0.17 rain=2.4 drop=0.25 up=0.9 rest=1.0 angryRest=0.7
}
