// Jelly types: what a run starts as (docs/jelly-types/spec-core.md). A first run is
// always Normal; later runs pick.
//
// Normal is BASE_STATS (src/stats.js). Every other type lists only where it differs, as
// `stat <name> <value>` lines: the value replaces Normal's (stat names as the `stat` effect word
// in src/words.js). Any other line is a treasure effect word (src/words.js) the type always has. `attack` is the type's one attack: bubble, an Element id, or tentacle.
// `hit` multiplies that attack's damage (the damage budget's one knob). `adorn` is the type's
// look, a piece drawn on top of the player's own jelly (src/adornments.js).
//
//   jelly "id" name="…" about="…" attack="…" hit=1 adorn="…" area=#true { stat <name> <value> … }
//
// `about` is the one line on the pick screen about the signature attack (src/pick-screen.js).
// `area` marks an attack that splashes, arcs or bursts: the screen's Area bar counts it 1.5x.
// `icon` is the type's picture in the Treasure book's Jellies page.
// `unlock-act=N` / `unlock-elites=N`: what opens the type, for good (docs/jelly-types/spec-meta.md):
// finish act N (beat its boss), or defeat N Elites across all runs. A type with neither is open
// from the start (Normal). src/jelly-types.js typeLock reads it.

jelly "normal" name="Normal Jelly" icon="🫧" about="Blows a plain, steady stream at the nearest bug. Simple and easy to read." attack="bubble" hit=1

// Fire: the Fire shot at full Fire rate. hit=0.5 lands it at 11.4 damage a second on one bug
// (7.5 x 0.5 x 1.5/s = 5.6 from hits, plus Burn 7.5 x 4.5 x 0.17 = 5.7/s, kept lit by every hit):
// the top of the 9-12 budget, for a glass cannon (docs/jelly-types/spec-core.md)
// hit= scales only the shot's own hit: Burn follows Attack damage alone, so a change to hit moves
// about half of Fire's damage
jelly "fire" name="Fire Jelly" icon="🔥" unlock-act=1 about="Fire shots set bugs burning, and a burning bug that dies lights the ones next to it." attack="fire" hit=0.5 adorn="ember" {
    stat bubble-damage 7.5
    stat move-speed 1.05
    stat health 19
    stat fire-rate 1.5
}

// Lightning: the Lightning shot at full Fire rate. hit=1 lands it at 9.9 damage a second on one bug
// (4.5 Attack damage x 1 x 2.2/s), inside the 9-12 budget; the arcs (41% each to 3 more bugs) and
// their Stun are for groups and aren't counted (docs/jelly-types/spec-core.md)
jelly "lightning" name="Lightning Jelly" icon="⚡" unlock-act=2 about="Each hit arcs to 3 more bugs nearby and stuns them for a moment." attack="lightning" hit=1 area=#true adorn="storm" {
    stat fire-rate 2.2
    stat move-speed 1.15
    stat bubble-damage 4.5
    stat health 22
}

// Ice: the Ice shard at full Fire rate. hit=1 lands it at 10.8 damage a second on one bug
// (9 x 1 x 1.2/s = 10.8; Chill only slows, so there is no damage over time in it), inside the 9-12 budget
// (docs/jelly-types/spec-core.md). A slow tank: the hits are few and heavy
jelly "ice" name="Ice Jelly" icon="❄️" unlock-elites=3 about="Slow ice shards chill bugs, so they crawl while you chip them down." attack="ice" hit=1 adorn="frost" {
    stat health 31
    stat shield 5
    stat bubble-damage 9
    stat fire-rate 1.2
    stat move-speed 0.88
    stat jump-height 0.9
}

// Poison: the blob hits the first bug for hit= x Attack damage, then its burst adds a Poison stack to
// every bug in 5 cm (6 at its Attack size). hit=0.6 lands it at 10.3 damage a second on one bug:
// 5 x 0.6 x 1.76/s = 5.3 from hits, plus 5 stacks (a hit every 0.57 s keeps all five of 5 s stacks)
// x 20% of 5 = 5.0/s from Poison, in the middle of the 9-12 budget (docs/jelly-types/spec-core.md).
// Poison follows Attack damage alone, not hit=. Health regen is per second: 0.5 every 5 s
jelly "poison" name="Poison Jelly" icon="🧪" unlock-act=3 about="A blob that bursts into Poison: bugs take damage over time and hit weaker." attack="poison" hit=0.6 adorn="toxin" area=#true {
    status-taken "poisoned" less=0.2
    stat health-regen 0.1
    stat bubble-size 1.2
    stat health 28
    stat bubble-damage 5
    stat range 0.25
}

// Wind: the gust at full Fire rate. hit=1.15 lands it at 10.35 damage a second on one bug (6 x 1.15 x 1.5/s,
// the 0.28 s wind-up inside each 0.67 s gust), in the middle of the 9-12 budget (docs/jelly-types/spec-core.md).
// Its pierce, push and the hit again on scenery are on top and don't count: they need other bugs or walls
jelly "wind" name="Wind Jelly" icon="🌬️" unlock-elites=9 about="Fast gusts blow through bugs and shove them back, even into furniture." attack="wind" hit=1.15 adorn="gale" {
    stat move-speed 1.2
    stat jump-height 1.2
    stat range 0.36
    stat pierce 1
    stat health 20
    stat fire-rate 1.5
}

// Glitter: slow bombs that burst in an 8 cm sphere (10 cm at its Attack size), 40% of Attack damage to
// every other bug inside, flying ones too. hit=1.3 lands it at 9.4 damage a second on one bug:
// 4.8 x 1.3 x 1.5/s (the splash never hits the bug the bomb hit, so it doesn't count), the low end of
// the 9-12 budget: a crowd of 5 takes 9.4 + 4 x 4.8 x 0.4 x 1.5 = 21 more (docs/jelly-types/spec-core.md)
jelly "glitter" name="Glitter Jelly" icon="✨" unlock-elites=6 about="Glitter bombs burst into a sparkling ball that splashes every bug inside." attack="glitter" hit=1.3 adorn="sparkle" area=#true {
    stat luck 10
    stat bubble-size 1.25
    stat dodge 5
    stat bubble-damage 4.8
    stat fire-rate 1.5
}

// Tentacle: Attacks tentacles each sting a different bug for Attack damage, Fire rate times a
// second: 9 x 1.76 = 15.8 a second on one bug, up to 47.5 on three in reach
jelly "tentacle" name="Tentacle Jelly" icon="🪼" unlock-act=4 about="No ranged attack: your tentacles sting up to 3 bugs in close reach." attack="tentacle" hit=1 adorn="barbs" {
    stat bubble-damage 9
    stat bubbles 3
    stat tentacle-reach 0.11
    stat health 32
    stat shield 3
    stat move-speed 1.1
}
