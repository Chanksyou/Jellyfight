// Nov 28: every type's Attack damage is 1 higher (Normal 6 to 7 in BASE_STATS, Wind takes that; the damage sums in the notes below are from before it).
// Jelly types: what a run starts as (docs/jelly-types/spec-core.md). A first run is
// always Normal; later runs pick.
//
// Normal is BASE_STATS (src/stats.js). Every other type lists only where it differs, as
// `stat <name> <value>` lines: the value replaces Normal's (stat names as the `stat` effect word
// in src/words.js). Any other line is a treasure effect word (src/words.js) the type always has. `attack` is the type's one attack: bubble, an Element id, or tentacle.
// `hit` multiplies that attack's damage (the damage budget's one knob). `adorn` is the type's
// look, a piece drawn on top of the player's own jelly (src/adornments.js). `aura` is the element the
// pick screen draws round the jelly on its card (src/pick-aura.js: bubbles, flames, frost, sparks,
// toxic, gust, glitter, sting).
//
//   jelly "id" name="…" about="…" attack="…" hit=1 adorn="…" aura="…" area=#true { stat <name> <value> … }
//
// `about` is the one line on the pick screen about the signature attack (src/pick-screen.js).
// `area` marks an attack that splashes, arcs or bursts: the screen's Area bar counts it 1.5x.
// `icon` is the type's picture in the Treasure book's Jellies page.
// `start-treasure="id"`: a Treasure the type starts every run with (level 1, not counted as found); taking it again levels it.
// `unlock-act=N` / `unlock-elites=N`: what opens the type, for good (docs/jelly-types/spec-meta.md):
// finish act N (beat its boss), or defeat N Elites across all runs. A type with neither is open
// from the start (Normal). src/jelly-types.js typeLock reads it.

jelly "normal" name="Normal Jelly" icon="💭" about="Blows a steady stream at the nearest bug. Simple and easy to read." attack="bubble" hit=1 aura="bubbles"

// Fire: the Fire shot at full Fire rate. hit=0.75 lands it at 14.2 damage a second on one bug
// (7.5 x 0.75 x 1.5/s = 8.4 from hits, plus Burn 7.5 x 4.5 x 0.17 = 5.7/s, kept lit by every hit):
// over the 9-12 budget on purpose: Burn doesn't grow with Fire rate cards, so Fire fell behind
// on the Vacuum and Clog once levelled (hit 0.5 -> 0.6, Nov 24: Vacuum fight about 20% shorter, Clog about 8%;
// hit 0.6 -> 0.75 and health 19 -> 17, Nov 27)
// hit= scales only the shot's own hit: Burn follows Attack damage alone, so a change to hit moves
// about half of Fire's damage
jelly "fire" name="Fire Jelly" icon="🔥" unlock-act=1 about="Shots Burn bugs, and a Burning bug that dies lights its neighbours." attack="fire" hit=0.75 adorn="ember" aura="flames" {
    stat bubble-damage 8.5
    stat move-speed 1.05
    stat health 17
    stat fire-rate 1.5
}

// Lightning: the Lightning shot at full Fire rate. hit=1 lands it at 9.9 damage a second on one bug
// (4.5 Attack damage x 1 x 2.2/s), inside the 9-12 budget; the arcs (41% each to 3 more bugs) and
// their Stun are for groups and aren't counted (docs/jelly-types/spec-core.md)
jelly "lightning" name="Lightning Jelly" icon="⚡" unlock-act=2 about="Each hit arcs to 3 more bugs and Stuns them briefly." attack="lightning" hit=1 area=#true adorn="storm" aura="sparks" {
    stat fire-rate 2.2
    stat move-speed 1.15
    stat bubble-damage 5.5
    stat health 22
}

// Ice: the Ice shard at full Fire rate. hit=1 lands it at 10.8 damage a second on one bug
// (9 x 1 x 1.2/s = 10.8; Chill only slows, so there is no damage over time in it), inside the 9-12 budget
// (docs/jelly-types/spec-core.md). A slow tank: the hits are few and heavy
jelly "ice" name="Ice Jelly" icon="❄️" unlock-elites=3 about="Slow shards Chill bugs so you can wear them down." attack="ice" hit=1 adorn="frost" aura="frost" {
    stat health 31
    stat shield 5
    stat bubble-damage 10
    stat fire-rate 1.2
    stat move-speed 0.88
    stat jump-height 0.9
}

// Poison: the blob hits the first bug for hit= x Attack damage, then its burst adds a Poison stack to
// every bug in 5 cm (6 at its Attack size). hit=0.6 lands it at 10.3 damage a second on one bug:
// 5 x 0.6 x 1.76/s = 5.3 from hits, plus 5 stacks (a hit every 0.57 s keeps all five of 5 s stacks)
// x 20% of 5 = 5.0/s from Poison, in the middle of the 9-12 budget (docs/jelly-types/spec-core.md).
// Poison follows Attack damage alone, not hit=. Health regen is per second: 0.5 every 5 s
jelly "poison" name="Poison Jelly" icon="🧪" unlock-act=3 about="Blobs burst into Poison: damage over time, and bugs hit weaker." attack="poison" hit=0.6 adorn="toxin" area=#true aura="toxic" {
    status-taken "poisoned" less=0.2
    stat health-regen 0.1
    stat bubble-size 1.2
    stat health 28
    stat bubble-damage 6
    stat range 0.25
}

// Wind: the gust at full Fire rate. hit=0.9 (Nov 27 tune, was 1.15) lands it at 8.1 damage a second on one bug (6 x 0.9 x 1.5/s,
// the 0.28 s wind-up inside each 0.67 s gust), under the 9-12 budget (docs/jelly-types/spec-core.md); its pierce and push are on top.
// Its pierce, push and the hit again on scenery are on top and don't count: they need other bugs or walls
jelly "wind" name="Wind Jelly" icon="🌬️" unlock-elites=9 about="Fast Gusts blow through bugs and shove them back, even into furniture." attack="wind" hit=0.9 adorn="gale" aura="gust" {
    stat move-speed 1.1
    stat jump-height 1.1
    stat range 0.4
    stat pierce 1
    stat health 20
    stat fire-rate 1.5
}

// Glitter: slow bombs that burst in an 8 cm sphere (12 cm at its Attack size, Nov 27 tune), 40% of Attack damage to
// every other bug inside, flying ones too. hit=1.3 lands it at 11.7 damage a second on one bug:
// 6 x 1.3 x 1.5/s (the splash never hits the bug the bomb hit, so it doesn't count), the low end of
// the 9-12 budget: a crowd of 5 takes 11.7 + 4 x 6 x 0.4 x 1.5 = 26.1 more (docs/jelly-types/spec-core.md)
jelly "glitter" name="Glitter Jelly" icon="✨" unlock-elites=6 about="Bombs burst into a sparkling splash that hits every bug inside." attack="glitter" hit=1.3 adorn="sparkle" area=#true aura="glitter" {
    stat luck 15
    stat bubble-size 1.5
    stat dodge 10
    stat bubble-damage 7
    stat fire-rate 1.5
}

// Nov 28 tune: Fire rate 1.5 to 1, Health 20 to 18, Move speed 1.08 to 0.9. The sums below are from before it.
// Nov 28 tune: Fire rate 1.5 to 1, Health 20 to 18, Move speed 1.08 to 0.9. The sums below are from before it.
// Summoner: the Signal (a light dart) at full Fire rate, and a Jelly Mould from the start (start-treasure=). hit=1 lands
// the Signal at 6.75 damage a second on one bug (4.5 x 1 x 1.5/s); the level 1 little jelly adds 4.5 x 0.4 x 1.25
// (Signalled) x 1.5/s = 3.4 while it is out, 8 s of every 10, so 2.7 on average: 9.5 together, the low end of the
// 9-12 budget (docs/jelly-types/types/summoner.md). Its Attack upgrades all work through the little jellies
jelly "summoner" name="Summoner Jelly" icon="📡" unlock-elites=9 start-treasure="jellyMould" about="Signals tag one bug at a time: your little jellies shoot it first, for 25% more damage." attack="signal" hit=1 adorn="beacon" aura="signal" {
    stat bubble-damage 5.5
    stat fire-rate 1
    stat range 0.36
    stat health 18
    stat move-speed 0.9
}

// Tentacle: Attacks tentacles each sting a different bug for Attack damage, Fire rate times a
// second: 9 x 1.76 = 15.8 a second on one bug, up to 47.5 on three in reach
jelly "tentacle" name="Tentacle Jelly" icon="🐙" unlock-act=4 about="No ranged attack: tentacles sting up to 3 bugs within reach." attack="tentacle" hit=1 adorn="barbs" aura="sting" {
    stat bubble-damage 10
    stat bubbles 3
    stat tentacle-reach 0.13
    stat health 35
    stat shield 3
    stat move-speed 1
}
